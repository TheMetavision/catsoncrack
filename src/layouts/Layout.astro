---
import { organizationSchema, websiteSchema } from '../lib/schema';
import { canonicalUrl } from '../lib/url';
import { socialImg } from '../lib/sanityImage';
import CartDrawer from '../components/CartDrawer';
// ── Theme audio additions (2026-04-30 — IP brand theme-tune feature build #4/4 — FINAL) ──
import CocChaosButton from '../components/CocChaosButton.astro';
import { getThemeAudio } from '../lib/sanity';
// ──────────────────────────────────────────────────────────────────────────────────────────

interface Props {
	title: string;
	description?: string;
	jsonLd?: Record<string, any> | Record<string, any>[];
	noIndex?: boolean;
	/** Absolute social-card image; defaults to the character line-up. */
	ogImage?: string;
}

const {
	title,
	description = "Join Cats On Crack for wild, chaotic adventures in our animated series. Watch character videos, read the book series, and shop official merch!",
	jsonLd,
	noIndex = false,
	ogImage = socialImg('/images/coc-characters.png'),
} = Astro.props;

// Titles stay within 60 characters: a trailing brand/section suffix
// (" | Cats On Crack", " — Cats On Crack", " — The Alleyway Gazette") is dropped
// before the page's own words are touched.
const TITLE_MAX = 60;
const fullTitle = title.length <= TITLE_MAX
  ? title
  : title.replace(/\s+[|—–-]\s+(Cats On Crack|The Alleyway Gazette)\s*$/, '');
// Descriptions stay within 155: drop whole trailing sentences first (many SEO
// descriptions end with a short brand line), then trim at a word boundary as
// a last resort. Never empty.
const DESC_MAX = 155;
function fitDescription(d: string): string {
  let clean = String(d || '').replace(/\s+/g, ' ').trim();
  if (clean.length <= DESC_MAX) return clean;
  const sentences = clean.split(/(?<=[.!?])\s+(?=[A-Z"“])/);
  while (sentences.length > 1 && sentences.join(' ').length > DESC_MAX) sentences.pop();
  clean = sentences.join(' ');
  if (clean.length <= DESC_MAX) return clean;
  const cut = clean.slice(0, DESC_MAX - 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s,;:—–-]+$/, '') + '…';
}
const metaDescription = fitDescription(description) || 'Join Cats On Crack for wild, chaotic adventures in our animated series. Watch character videos, read the book series, and shop official merch!';

// Apex host, trailing slash: the address Netlify actually serves.
const pageUrl = canonicalUrl(Astro.url.pathname);

const allSchemas = [organizationSchema(), websiteSchema()];
if (jsonLd) {
	if (Array.isArray(jsonLd)) allSchemas.push(...jsonLd);
	else allSchemas.push(jsonLd);
}

// ── Theme audio: fetch + suppression matcher ───────────────────────────────────
// Single fetch at build time. Result drives both the <link rel="preload"> hint
// in <head> AND the <CocChaosButton ... /> render at end of <body>.
// Suppression paths per Arc spec arc-spec-coc-theme-tune-content-2026-04-30.md
// Section E.2 — control hides on commerce flows ONLY (3 paths — shortest of all
// four brands; COC has no /media equivalent unlike BB).
const themeAudio = await getThemeAudio();

const SUPPRESSION_PATTERNS = [
	/^\/cart(\/.*)?$/,
	/^\/checkout(\/.*)?$/,
	/^\/order(\/.*)?$/,
];
const isSuppressedRoute = SUPPRESSION_PATTERNS.some((p) => p.test(Astro.url.pathname));
const renderThemeAudio = themeAudio.enabled && !!themeAudio.audioUrl && !isSuppressedRoute;
const preloadAudio = renderThemeAudio ? themeAudio.audioUrl : null;
// ───────────────────────────────────────────────────────────────────────────────
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription} />
		<meta name="viewport" content="width=device-width" />
		{noIndex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png">
		<link rel="canonical" href={pageUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="preload" href="/fonts/bebasneue-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="stylesheet" href="/fonts/fonts.css">

		<!-- Open Graph -->
		<meta property="og:title" content={`${title} | Cats On Crack`} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:site_name" content="Cats On Crack" />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@Cats_on_Crack_" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />

		<!-- JSON-LD -->
		{allSchemas.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}

		{/* Theme audio preload — low priority, only emitted when audio will render */}
		{preloadAudio && (
			<link
				rel="preload"
				href={preloadAudio}
				as="audio"
				type="audio/mpeg"
				fetchpriority="low"
			/>
		)}

		<title>{fullTitle}</title>
	</head>
	<body>
		<slot />
		<CartDrawer client:load />
		{/* Theme audio control — Glitchy Chaos Button (Gizmo the Genius invention) */}
		{renderThemeAudio && (
			<CocChaosButton
				audioUrl={themeAudio.audioUrl}
				trackTitle={themeAudio.trackTitle}
				trackArtist={themeAudio.trackArtist}
				enabled={themeAudio.enabled}
			/>
		)}
	</body>
</html>

<style is:global>
	:root {
		--black:        #181b22;
		--charcoal:     #181b22;
		--charcoal-mid: #181b22;
		--charcoal-light: #1f232e;
		--charcoal-card: #252a38;
		--amber:        #ff8c00;
		--amber-light:  #ffaa33;
		--amber-dim:    rgba(255,140,0,0.55);
		--neon:         #ff00ff;
		--neon-dim:     rgba(255,0,255,0.45);
		--neon-glow:    0 0 18px rgba(255,0,255,0.55), 0 0 40px rgba(255,0,255,0.25);
		--primary:       #ff00ff;
		--primary-dark:  #cc00cc;
		--primary-light: #ff33ff;
		--secondary:     #ff00ff;
		--bg-dark:       #1f232e;
		--bg-darker:     #181b22;
		--bg-navy:       #181b22;
		--bg-card:       #252a38;
		--text-primary:  #f0ede8;
		--text-secondary: #9ea3b0;
		--accent-gradient: linear-gradient(135deg, #ff00ff 0%, #cc00cc 100%);
		--glow:       0 0 18px rgba(255,0,255,0.4);
		--glow-strong:0 0 30px rgba(255,0,255,0.6);
	}

	* { box-sizing: border-box; margin: 0; padding: 0; }

	html {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		background: #181b22;
		color: var(--text-primary);
		scroll-behavior: smooth;
		overflow-x: hidden;
	}

	body { line-height: 1.6; background: #181b22; min-height: 100vh; }

	h1, h2, h3, h4, h5, h6 {
		font-family: 'Bebas Neue', 'Impact', sans-serif;
		letter-spacing: 1px;
		line-height: 1.15;
	}

	a { color: var(--primary); text-decoration: none; transition: all 0.3s ease; }
	a:hover { color: var(--primary-light); text-shadow: var(--neon-glow); }
	button { font-family: 'Bebas Neue', 'Impact', sans-serif; cursor: pointer; border: none; transition: all 0.3s ease; }
	img { max-width: 100%; height: auto; display: block; }

	.container { max-width: 1400px; margin: 0 auto; padding: 0 20px; }
	.section { padding: 100px 0; position: relative; }

	@media (max-width: 768px) { .section { padding: 60px 0; } }

	.glow-text { text-shadow: 0 0 10px rgba(255,0,255,0.6), 0 0 22px rgba(255,0,255,0.35), 0 0 45px rgba(255,0,255,0.18); }
	.glow-amber { text-shadow: 0 0 10px rgba(255,140,0,0.7), 0 0 24px rgba(255,140,0,0.35); }

	.fade-up { opacity: 0; transform: translateY(40px); transition: opacity 0.75s cubic-bezier(0.22,1,0.36,1), transform 0.75s cubic-bezier(0.22,1,0.36,1); }
	.fade-up.visible { opacity: 1; transform: translateY(0); }
	.fade-left { opacity: 0; transform: translateX(-48px); transition: opacity 0.8s cubic-bezier(0.22,1,0.36,1), transform 0.8s cubic-bezier(0.22,1,0.36,1); }
	.fade-left.visible { opacity: 1; transform: translateX(0); }
	.fade-right { opacity: 0; transform: translateX(48px); transition: opacity 0.8s cubic-bezier(0.22,1,0.36,1), transform 0.8s cubic-bezier(0.22,1,0.36,1); }
	.fade-right.visible { opacity: 1; transform: translateX(0); }
	.stagger-children > * { opacity: 0; transform: translateY(32px); transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1), transform 0.6s cubic-bezier(0.22,1,0.36,1); }
	.stagger-children.visible > *:nth-child(1) { transition-delay: 0ms; }
	.stagger-children.visible > *:nth-child(2) { transition-delay: 80ms; }
	.stagger-children.visible > *:nth-child(3) { transition-delay: 160ms; }
	.stagger-children.visible > *:nth-child(4) { transition-delay: 240ms; }
	.stagger-children.visible > *:nth-child(5) { transition-delay: 320ms; }
	.stagger-children.visible > * { opacity: 1; transform: translateY(0); }
	.fade-in { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease, transform 0.8s ease; }
	.fade-in.visible { opacity: 1; transform: translateY(0); }

	::-webkit-scrollbar { width: 10px; }
	::-webkit-scrollbar-track { background: #181b22; }
	::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 5px; }
	::-webkit-scrollbar-thumb:hover { background: var(--primary-light); }
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const obs = new IntersectionObserver((entries) => {
			entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
		}, { threshold: 0.08, rootMargin: '0px 0px -80px 0px' });
		document.querySelectorAll('.fade-in,.fade-up,.fade-left,.fade-right,.stagger-children').forEach(el => obs.observe(el));

		const counterObs = new IntersectionObserver((entries) => {
			entries.forEach(e => {
				if (!e.isIntersecting) return;
				const el = e.target as HTMLElement;
				const target = parseInt(el.dataset.count || '0', 10);
				const suffix = el.dataset.suffix || '';
				if (!target) return;
				const duration = 1400;
				const step = (timestamp: number, startTime: number) => {
					const progress = Math.min((timestamp - startTime) / duration, 1);
					const eased = 1 - Math.pow(1 - progress, 3);
					el.textContent = Math.floor(eased * target) + suffix;
					if (progress < 1) requestAnimationFrame(ts => step(ts, startTime));
				};
				requestAnimationFrame(ts => step(ts, ts));
				counterObs.unobserve(el);
			});
		}, { threshold: 0.5 });
		document.querySelectorAll('[data-count]').forEach(el => counterObs.observe(el));
	});
</script>
