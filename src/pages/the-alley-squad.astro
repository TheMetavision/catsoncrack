---
import { sanityImg, sanitySrcset, sanityDims, socialImg } from '../lib/sanityImage';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
// Shared client: it carries SANITY_API_TOKEN, so characters with dotted IDs are readable.
import { client, getHomeSettings, hasLiveEpisode } from '../lib/sanity';

// Group scenes from the wall-art range, used in the hero and the faction headers.
// Looked up by slug so a regenerated print updates the page on the next build.
const HERO_ART = ['lunch-on-a-girder', 'tabby-road'];
const FACTION_ART: Record<string, string> = { rivals: 'the-usual-suspurrs' };

const [allCharacters, groupArt, home, seriesLive] = await Promise.all([
	client.fetch(`
		*[_type == "character" && !(_id in path('drafts.**'))]
			| order(coalesce(sortOrder, displayOrder, 999) asc, name asc) {
			name,
			"slug": slug.current,
			role,
			bio,
			tagline,
			traits,
			quote,
			faction,
			"accent": coalesce(accentColor, accent),
			initials,
			externalImageUrl,
			"imageUrl": image.asset->url
		}
	`),
	client.fetch(
		`*[_type == "wallArt" && slug.current in $slugs && !(_id in path('drafts.**'))]{
			title, "slug": slug.current, "url": image.asset->url
		}`,
		{ slugs: [...HERO_ART, ...Object.values(FACTION_ART)] }
	),
	getHomeSettings().catch(() => null),
	hasLiveEpisode().catch(() => false),
]);

const artBySlug: Record<string, { title: string; slug: string; url: string }> = Object.fromEntries(
	(groupArt || []).filter((a: any) => a?.url).map((a: any) => [a.slug, a])
);
const heroSlides = HERO_ART.map((s) => artBySlug[s]).filter(Boolean);

const trailerId = home?.trailerYoutubeId?.trim();
const youtubeUrl = trailerId && /^[\w-]{6,20}$/.test(trailerId)
	? `https://www.youtube.com/shorts/${trailerId}`
	: home?.youtubeChannelUrl || 'https://www.youtube.com/@CatsOnCrackMedia';
const watchLabel = seriesLive ? 'Watch on YouTube' : 'Watch the trailer';

const shortNames: Record<string, string> = {
	"The Alley Cat King": "Alley King",
	"The Rat Pack": "Rat Pack",
	"Old Man Whiskers": "Old Man W",
	"Professor Paws": "Prof. Paws",
	"Madame Meow": "Madame",
};

const characters = allCharacters.map((char: any, i: number) => {
	const accent = /^#[0-9a-f]{6}$/i.test(char.accent || '') ? char.accent : '#ff8c00';
	const r = parseInt(accent.slice(1, 3), 16);
	const g = parseInt(accent.slice(3, 5), 16);
	const b = parseInt(accent.slice(5, 7), 16);
	const realImage = char.imageUrl || char.externalImageUrl || null;
	const dims = realImage ? sanityDims(realImage, 100) : {};
	// Portrait renders fill the 2:3 frame; square or landscape art (e.g. the Rat Pack) is shown whole.
	const portrait = 'height' in dims && dims.height / dims.width >= 1.3;
	return {
		...char,
		accent,
		accentDim: `rgba(${r}, ${g}, ${b}, 0.12)`,
		accentGlow: `rgba(${r}, ${g}, ${b}, 0.3)`,
		initials: char.initials || char.name.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase(),
		traits: char.traits || [],
		quote: char.quote || '',
		tagline: char.tagline || char.role || '',
		role: char.role || '',
		bio: char.bio || '',
		realImage,
		fit: portrait || !realImage ? 'fit-cover' : 'fit-contain',
		avatar: realImage ? `${sanityImg(realImage, 88, { h: 116 })}&crop=top` : null,
		shortName: shortNames[char.name] || char.name.split(' ')[0],
		faction: ['crew', 'allies', 'rivals'].includes(char.faction) ? char.faction : 'crew',
		// Anchor id, so links like /the-alley-squad#jinx land on the right profile.
		anchor: char.slug || `char-${i}`,
	};
});

const FACTIONS = [
	{
		key: 'crew',
		label: 'The Crew',
		short: 'Crew',
		blurb: (n: number) => `The core of the alley. ${n} cats with no plan, no impulse control and no intention of getting either.`,
	},
	{
		key: 'allies',
		label: 'Allies',
		short: 'Allies',
		blurb: () => `Not crew, not enemies. Useful right up until they aren't, and they'll want paying either way.`,
	},
	{
		key: 'rivals',
		label: 'Rivals',
		short: 'Rivals',
		blurb: () => `The ones trying to run the alley, clean it up or sell it off. They lose every time. They're back every time.`,
	},
];

const groups = FACTIONS.map((f, gi) => {
	const members = characters.filter((c: any) => c.faction === f.key);
	const art = FACTION_ART[f.key] ? artBySlug[FACTION_ART[f.key]] : undefined;
	return { ...f, number: String(gi + 1).padStart(2, '0'), members, art, blurbText: f.blurb(members.length) };
}).filter((g) => g.members.length > 0);

const ogImage = heroSlides[0] ? socialImg(sanityImg(heroSlides[0].url, 1200, { h: 630 })) : undefined;
---

<Layout
	title="The Alley Squad - Cats On Crack"
	description={`Meet all ${characters.length} Cats On Crack characters: the crew, their dodgy allies and the rivals trying to shut the alley down.`}
	ogImage={ogImage}
>
	<Navigation />

	<main data-filter="all">
		<section class="squad-hero" aria-labelledby="squad-title">
			{heroSlides.length > 0 && (
				<div class="hero-slides" aria-hidden="true">
					{heroSlides.map((s, i) => (
						<img
							class={`hero-slide ${i === 0 ? 'is-active' : ''}`}
							src={sanityImg(s.url, 1600)}
							srcset={sanitySrcset(s.url, 1920)}
							sizes="100vw"
							{...sanityDims(s.url, 1600)}
							alt=""
							loading={i === 0 ? 'eager' : 'lazy'}
							fetchpriority={i === 0 ? 'high' : 'low'}
							data-title={s.title}
							data-href={`/wall-art/${s.slug}`}
						/>
					))}
				</div>
			)}
			<div class="hero-shade"></div>
			<div class="container hero-content">
				<div class="hero-eyebrow">Est. The Streets</div>
				<h1 id="squad-title" class="page-title">The Alley Squad</h1>
				<p class="hero-subtitle">{characters.length} characters. Zero rules. One alley.</p>
				<p class="hero-lede">This isn't your average crew. Every one of them brings their own brand of chaos, skill and attitude, and nobody is getting any better.</p>
				<ul class="hero-stats">
					{groups.map((g) => (
						<li><a href={`#${g.key}`}><strong>{g.members.length}</strong> {g.short}</a></li>
					))}
				</ul>
				<div class="hero-buttons">
					<a href="#crew" class="cta-button primary">Meet the crew</a>
					{groups.some((g) => g.key === 'rivals') && <a href="#rivals" class="cta-button secondary">Meet the rivals</a>}
					<a href={youtubeUrl} target="_blank" rel="noopener" class="cta-button ghost">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
						{watchLabel}
					</a>
				</div>
			</div>
			{heroSlides.length > 0 && (
				<a class="hero-credit" href={`/wall-art/${heroSlides[0].slug}`} data-hero-credit>
					On the wall: <span data-hero-credit-title>{heroSlides[0].title}</span> <span aria-hidden="true">&rarr;</span>
				</a>
			)}
		</section>

		<div class="squad-bar" data-squad-bar>
			<div class="container squad-bar-inner">
				<div class="faction-filters" role="group" aria-label="Show characters by faction">
					<button type="button" class="filter-chip is-active" data-filter-btn="all" aria-pressed="true">All <span>{characters.length}</span></button>
					{groups.map((g) => (
						<button type="button" class="filter-chip" data-filter-btn={g.key} aria-pressed="false">{g.label} <span>{g.members.length}</span></button>
					))}
				</div>
				<nav class="avatar-strip" aria-label="Jump to a character">
					{characters.map((c: any) => (
						<a href={`#${c.anchor}`} class="avatar" data-faction={c.faction} style={`--accent: ${c.accent}`} title={c.name}>
							{c.avatar ? (
								<img src={c.avatar} width="44" height="58" alt={c.name} loading="lazy" />
							) : (
								<span class="avatar-initials">{c.initials}</span>
							)}
						</a>
					))}
				</nav>
			</div>
		</div>

		{groups.map((g) => (
			<section id={g.key} class={`section faction-section faction-${g.key}`} data-faction-section={g.key} aria-labelledby={`${g.key}-title`}>
				<div class="container">
					<header class={`faction-header ${g.art ? 'has-art' : ''} fade-in`}>
						<div class="faction-copy">
							<div class="section-eyebrow">Faction {g.number} &middot; {g.members.length} {g.members.length === 1 ? 'member' : 'members'}</div>
							<h2 id={`${g.key}-title`}>{g.label}</h2>
							<p>{g.blurbText}</p>
							<div class="faction-faces">
								{g.members.map((c: any) => (
									<a href={`#${c.anchor}`} class="face" style={`--accent: ${c.accent}`} title={c.name}>
										{c.avatar ? <img src={c.avatar} width="40" height="40" alt={c.name} loading="lazy" /> : <span>{c.initials}</span>}
									</a>
								))}
							</div>
						</div>
						{g.art && (
							<a href={`/wall-art/${g.art.slug}`} class="faction-art">
								<img
									src={sanityImg(g.art.url, 900)}
									srcset={sanitySrcset(g.art.url, 720)}
									sizes="(min-width: 969px) 600px, 92vw"
									{...sanityDims(g.art.url, 900)}
									alt={`${g.art.title} wall art: the rivals in a police line-up`}
									loading="lazy"
								/>
								<span class="faction-art-label">{g.art.title}: get the print <span aria-hidden="true">&rarr;</span></span>
							</a>
						)}
					</header>

					<div class="character-profiles">
						{g.members.map((char: any, i: number) => (
							<article
								id={char.anchor}
								class={`character-profile fade-in ${i % 2 === 1 ? 'reverse' : ''}`}
								style={`--char-accent: ${char.accent}; --char-dim: ${char.accentDim}; --char-glow: ${char.accentGlow}`}
							>
								<div class="character-image-col">
									<div class="character-frame">
										{char.realImage ? (
											<img
												src={sanityImg(char.realImage, 680)}
												srcset={sanitySrcset(char.realImage, 340)}
												sizes="(min-width: 1101px) 340px, (min-width: 969px) 280px, 320px"
												{...sanityDims(char.realImage, 680)}
												alt={char.name}
												class={`char-real-image ${char.fit}`}
												loading="lazy"
											/>
										) : (
											<svg viewBox="0 0 100 100" class="silhouette-svg" aria-hidden="true">
												<polygon points="50,5 95,25 95,75 50,95 5,75 5,25" fill={char.accentDim} stroke={char.accent} stroke-width="0.8" opacity="0.5"/>
												<text x="50" y="52" text-anchor="middle" dominant-baseline="middle" font-size="28" font-weight="900" font-family="Impact, sans-serif" fill={char.accent} opacity="0.8">{char.initials}</text>
											</svg>
										)}
										<div class="char-scanlines"></div>
										<div class="char-vignette"></div>
									</div>
								</div>

								<div class="character-info">
									<div class="char-role-line">
										<span class="char-role-badge" style={`background: ${char.accentDim}; border-color: ${char.accent}; color: ${char.accent}`}>{char.role}</span>
									</div>
									<h3 class="char-name">{char.name}</h3>
									{char.tagline && <p class="char-tagline">"{char.tagline}"</p>}
									<p class="character-bio">{char.bio}</p>
									{char.traits.length > 0 && (
										<div class="character-traits">
											{char.traits.map((t: string) => (
												<span class="trait" style={`background: ${char.accentDim}; border-color: ${char.accent}; color: ${char.accent}`}>{t}</span>
											))}
										</div>
									)}
									{char.quote && (
										<blockquote class="character-quote-block" style={`border-color: ${char.accent}`}>
											<span class="quote-mark" style={`color: ${char.accent}`}>&ldquo;</span>
											{char.quote}
											<span class="quote-mark" style={`color: ${char.accent}`}>&rdquo;</span>
										</blockquote>
									)}
								</div>
							</article>
						))}
					</div>
				</div>
			</section>
		))}

		<section class="section cta-section">
			<div class="container">
				<div class="cta-box fade-in">
					<div class="cta-grid-bg"></div>
					<h2>Want to See Them in Action?</h2>
					<p>
						{seriesLive
							? "Watch the crew's latest disasters on YouTube, or dig into their stories in The Alleyway Gazette."
							: "Series 1 is on the way. Catch the trailer now, or dig into their stories in The Alleyway Gazette."}
					</p>
					<div class="cta-buttons">
						<a href={youtubeUrl} target="_blank" rel="noopener" class="cta-button primary">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
							{watchLabel}
						</a>
						<a href="/alleyway-gazette" class="cta-button secondary">Read Their Stories</a>
					</div>
				</div>
			</div>
		</section>

		<a href="#squad-title" class="back-to-top" data-back-to-top aria-label="Back to the top">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
		</a>
	</main>

	<Footer />
</Layout>

<script>
	const main = document.querySelector<HTMLElement>('main[data-filter]');
	const bar = document.querySelector<HTMLElement>('[data-squad-bar]');
	const nav = document.querySelector<HTMLElement>('.navbar');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Keep the sticky bar and anchor landings clear of the fixed nav.
	const setOffsets = () => {
		const navH = nav?.offsetHeight ?? 100;
		document.documentElement.style.setProperty('--nav-h', `${navH}px`);
		document.documentElement.style.setProperty('--bar-h', `${bar?.offsetHeight ?? 0}px`);
	};
	setOffsets();
	window.addEventListener('resize', setOffsets);
	window.addEventListener('scroll', setOffsets, { passive: true, once: true });

	// Hero crossfade between the group scenes; the credit link follows the visible print.
	const slides = [...document.querySelectorAll<HTMLImageElement>('.hero-slide')];
	const credit = document.querySelector<HTMLAnchorElement>('[data-hero-credit]');
	const creditTitle = document.querySelector<HTMLElement>('[data-hero-credit-title]');
	if (slides.length > 1 && !reduceMotion) {
		let current = 0;
		setInterval(() => {
			if (document.hidden) return;
			slides[current].classList.remove('is-active');
			current = (current + 1) % slides.length;
			const next = slides[current];
			next.loading = 'eager';
			next.classList.add('is-active');
			if (credit && creditTitle) {
				credit.href = next.dataset.href || credit.href;
				creditTitle.textContent = next.dataset.title || '';
			}
		}, 7000);
	}

	// Faction filter: shows one faction's section and avatars, or everything.
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]')];
	const applyFilter = (value: string, scroll: boolean) => {
		if (!main) return;
		main.dataset.filter = value;
		buttons.forEach((b) => {
			const on = b.dataset.filterBtn === value;
			b.classList.toggle('is-active', on);
			b.setAttribute('aria-pressed', String(on));
		});
		if (scroll) {
			const target = value === 'all'
				? document.querySelector('[data-faction-section]')
				: document.querySelector(`[data-faction-section="${value}"]`);
			target?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
		}
		// Reveal anything the fade-in observer hasn't reached yet in the newly shown section.
		document.querySelectorAll('.faction-section:not([hidden]) .fade-in').forEach((el) => {
			const r = el.getBoundingClientRect();
			if (r.top < window.innerHeight) el.classList.add('visible');
		});
	};
	buttons.forEach((b) => b.addEventListener('click', () => applyFilter(b.dataset.filterBtn || 'all', true)));

	// A link to a profile in a hidden faction (e.g. #jinx while "Rivals" is on) resets the filter first.
	const revealHash = () => {
		const id = decodeURIComponent(location.hash.slice(1));
		if (!id || !main) return;
		const el = document.getElementById(id);
		const section = el?.closest<HTMLElement>('[data-faction-section]');
		if (section && main.dataset.filter !== 'all' && main.dataset.filter !== section.dataset.factionSection) {
			applyFilter('all', false);
			el?.scrollIntoView({ block: 'start' });
		}
	};
	window.addEventListener('hashchange', revealHash);
	document.querySelectorAll<HTMLAnchorElement>('main a[href^="#"]').forEach((a) => {
		a.addEventListener('click', () => {
			const id = a.getAttribute('href')!.slice(1);
			const section = document.getElementById(id)?.closest<HTMLElement>('[data-faction-section]');
			if (main && section && main.dataset.filter !== 'all' && main.dataset.filter !== section.dataset.factionSection) {
				applyFilter('all', false);
			}
		});
	});

	// While showing everything, highlight the faction currently on screen.
	const sections = [...document.querySelectorAll<HTMLElement>('[data-faction-section]')];
	const sectionObs = new IntersectionObserver((entries) => {
		if (main?.dataset.filter !== 'all') return;
		entries.forEach((e) => {
			if (!e.isIntersecting) return;
			const key = (e.target as HTMLElement).dataset.factionSection;
			buttons.forEach((b) => b.classList.toggle('is-current', b.dataset.filterBtn === key));
		});
	}, { rootMargin: '-45% 0px -50% 0px' });
	sections.forEach((s) => sectionObs.observe(s));

	// Back-to-top appears once the hero has scrolled away.
	const backToTop = document.querySelector<HTMLElement>('[data-back-to-top]');
	const hero = document.querySelector('.squad-hero');
	if (backToTop && hero) {
		new IntersectionObserver(([e]) => backToTop.classList.toggle('is-visible', !e.isIntersecting)).observe(hero);
		backToTop.addEventListener('click', (ev) => {
			ev.preventDefault();
			window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
		});
	}
</script>

<style>
	/* ─── Hero ─────────────────────────────────────────────── */
	.squad-hero { position: relative; min-height: min(88vh, 860px); display: flex; align-items: flex-end; overflow: hidden; background: #181b22; padding: calc(var(--nav-h, 108px) + 40px) 0 70px; }
	.hero-slides { position: absolute; inset: 0; }
	.hero-slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; opacity: 0; transform: scale(1.04); transition: opacity 1.4s ease, transform 8s ease-out; }
	.hero-slide.is-active { opacity: 1; transform: scale(1.1); }
	.hero-shade { position: absolute; inset: 0; pointer-events: none; background:
		linear-gradient(90deg, rgba(14,15,20,0.88) 0%, rgba(14,15,20,0.62) 36%, rgba(14,15,20,0.1) 62%, transparent 100%),
		linear-gradient(0deg, var(--bg-dark) 0%, rgba(24,27,34,0.0) 35%),
		linear-gradient(180deg, rgba(8,8,10,0.6) 0%, transparent 22%); }
	.hero-content { position: relative; z-index: 2; width: 100%; }
	.hero-content > * { max-width: 620px; }
	.hero-eyebrow { font-family: 'Bebas Neue', sans-serif; font-size: 0.9rem; letter-spacing: 5px; text-transform: uppercase; color: #ff00ff; margin-bottom: 10px; }
	.page-title { font-family: 'Bebas Neue', 'Impact', sans-serif; font-size: clamp(3.4rem, 9vw, 8rem); line-height: 0.88; color: #fff; letter-spacing: 3px; margin-bottom: 16px; text-shadow: 4px 4px 0 rgba(255,0,255,0.45), 0 0 50px rgba(255,0,255,0.25); max-width: none; }
	.hero-subtitle { font-family: 'Bebas Neue', sans-serif; font-size: 1.35rem; color: #fff; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; }
	.hero-lede { font-size: 1.05rem; line-height: 1.7; color: rgba(225, 222, 218, 0.85); margin-bottom: 22px; }
	.hero-stats { list-style: none; padding: 0; margin: 0 0 26px; display: flex; flex-wrap: wrap; gap: 10px; }
	.hero-stats a { display: inline-flex; align-items: baseline; gap: 6px; padding: 7px 14px; border-radius: 999px; background: rgba(14,15,20,0.6); border: 1px solid rgba(255,0,255,0.35); color: rgba(225,222,218,0.9); font-size: 0.8rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; backdrop-filter: blur(6px); }
	.hero-stats a:hover { border-color: #ff00ff; color: #fff; text-shadow: none; }
	.hero-stats strong { font-family: 'Bebas Neue', sans-serif; font-size: 1.25rem; letter-spacing: 1px; color: #ff00ff; }
	.hero-buttons { display: flex; flex-wrap: wrap; gap: 14px; }
	.hero-credit { position: absolute; right: 24px; bottom: 22px; z-index: 2; font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(225,222,218,0.75); background: rgba(14,15,20,0.6); padding: 6px 12px; border-radius: 999px; backdrop-filter: blur(6px); }
	.hero-credit:hover { color: #fff; text-shadow: none; }

	/* ─── Sticky squad bar ─────────────────────────────────── */
	.squad-bar { position: sticky; top: var(--nav-h, 100px); z-index: 50; background: rgba(18, 20, 26, 0.94); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255, 0, 255, 0.15); }
	.squad-bar-inner { display: flex; align-items: center; gap: 20px; padding-top: 10px; padding-bottom: 10px; }
	.faction-filters { display: flex; gap: 8px; flex-shrink: 0; }
	.filter-chip { font: inherit; cursor: pointer; padding: 7px 14px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.15); background: transparent; color: rgba(210,205,200,0.85); font-size: 0.75rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; white-space: nowrap; transition: all 0.2s ease; }
