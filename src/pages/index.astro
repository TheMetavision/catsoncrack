---
import fs from 'node:fs';
import path from 'node:path';
import { PortableText } from 'astro-portabletext';
import { sanityImg, sanitySrcset, localImg, localSrcset, productImg } from '../lib/sanityImage';
import MerchPromo from '../components/MerchPromo.astro';
import Layout from '../layouts/Layout.astro';
import { tvSeriesSchema } from '../lib/schema';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SectionDivider from '../components/SectionDivider.astro';
import { getHomeSettings, hasLiveEpisode, getCharacterCount, getSquadCharacters, getHomeWorldLocations, getAllBooks, bookBuyUrl, urlFor } from '../lib/sanity';

const settings = await getHomeSettings();
const positioningLine = settings?.positioningLine?.trim()
	|| 'An adult animated comedy about a gang of alley cats scheming, brawling and hustling their way through the backstreets of Meowtown.';
const youtubeChannelUrl = settings?.youtubeChannelUrl || 'https://www.youtube.com/@CatsOnCrackMedia';
const subscribeUrl = `${youtubeChannelUrl}?sub_confirmation=1`;

// Trailer: only when siteSettings has a plausible YouTube ID. The poster is
// self-hosted (public/video-thumbs/<id>.jpg, else a generic alley still) so
// nothing loads from YouTube before the visitor presses play.
const rawTrailerId = settings?.trailerYoutubeId?.trim();
const trailerId = rawTrailerId && /^[\w-]{6,20}$/.test(rawTrailerId) ? rawTrailerId : null;
const ownThumb = trailerId && fs.existsSync(path.join(process.cwd(), 'public', 'video-thumbs', `${trailerId}.jpg`));
const seriesPoster = ownThumb
	? { src: `/video-thumbs/${trailerId}.jpg`, width: 1280 }
	: { src: '/images/coc-heist.jpg', width: 1392 };

// Series copy follows episode status (a missing status counts as coming soon),
// so the page never claims an episode is out early.
const seriesLive = await hasLiveEpisode();

const characterCount = await getCharacterCount();

// The six characters hard-coded in the hero carousel below. No character has
// coreSix set in Sanity yet, so the squad grid also skips these by slug.
const HERO_SLUGS = ['toothless-terry', 'whiskers-mcscruff', 'luna-the-loner', 'chubby-cheeks', 'gizmo-the-genius', 'trixie-the-trickster'];
const squad = (await getSquadCharacters(HERO_SLUGS, 6)).map((c: any) => ({
	name: c.name,
	slug: c.slug,
	role: c.role,
	line: c.quote || c.tagline || '',
	image: c.imageUrl,
}));

const alleyCards = (await getHomeWorldLocations()).map((loc: any) => ({
	name: loc.title,
	slug: loc.slug,
	tagline: loc.tagline,
	image: sanityImg(loc.imageUrl, 640, { h: 400 }),
	drawerImage: sanityImg(loc.imageUrl, 960, { h: 544 }),
	alt: loc.alt || loc.title,
	description: loc.description,
	// A card opens the drawer only once its location has a description.
	hasDrawer: Boolean(loc.slug) && Array.isArray(loc.description) && loc.description.length > 0,
	residents: loc.residents ?? [],
	products: (loc.featuredProducts ?? []).map((p: any) => ({
		name: p.name,
		slug: p.slug,
		image: productImg(p.imageUrl || p.heroImageUrl, 400),
	})),
}));

const books = (await getAllBooks()).map((b: any) => ({
	title: b.title,
	cover: b.coverImage?.asset ? urlFor(b.coverImage).width(360).height(540).fit('crop').auto('format').url() : '',
	comingSoon: b.status === 'coming-soon',
	buyUrl: bookBuyUrl(b),
}));
const anyBookPending = books.some((b) => !b.buyUrl);
---

<Layout title="Cats On Crack - The Wildest Alley Cats You'll Ever Meet" jsonLd={tvSeriesSchema()}>
	<Navigation />

	<main>
		<section class="hero">
			<div class="hero-urban-bg"></div>
			<div class="hero-grain"></div>

			<div class="hero-split container">
				<div class="hero-image-col fade-left hero-anim-immediate">
					<div class="character-carousel" id="heroCarousel">

						<div class="carousel-slide active" data-index="0">
							<div class="character-frame">
								<img
									src={sanityImg("https://cdn.sanity.io/images/8ksun996/production/5417f6065374acc6ea2a64473e8c896e3742fca0-896x1344.png", 460)}
									srcset={sanitySrcset("https://cdn.sanity.io/images/8ksun996/production/5417f6065374acc6ea2a64473e8c896e3742fca0-896x1344.png", 460)}
									sizes="(min-width: 900px) 460px, 320px"
									width="460"
									height="690"
									alt="Toothless Terry"
									class="hero-character"
									loading="eager"
									fetchpriority="high"
								/>
								<div class="character-ground-vignette"></div>
								<div class="character-nameplate">
									<div class="nameplate-name">Toothless Terry</div>
									<div class="nameplate-role">The Scheme Engine</div>
								</div>
								<div class="character-tagline">"Here's the thing about problems, pal — a problem is just a deal that hasn't been structured yet."</div>
							</div>
						</div>

						<div class="carousel-slide" data-index="1">
							<div class="character-frame">
								<img
									src={sanityImg("https://cdn.sanity.io/images/8ksun996/production/03c37b531e58887940cdecfcde357725bf1d93f7-1920x1080.png", 460, { h: 690 })}
									srcset={[320, 460, 640, 920].map((w) => `${sanityImg("https://cdn.sanity.io/images/8ksun996/production/03c37b531e58887940cdecfcde357725bf1d93f7-1920x1080.png", w, { h: w * 1.5 })} ${w}w`).join(', ')}
									sizes="(min-width: 900px) 460px, 320px"
									width="460"
									height="690"
									alt="Whiskers McScruff"
									class="hero-character"
									loading="lazy"
								/>
								<div class="character-ground-vignette"></div>
								<div class="character-nameplate">
									<div class="nameplate-name">Whiskers McScruff</div>
									<div class="nameplate-role">The Leader</div>
								</div>
								<div class="character-tagline">"Chaos is the cure. I've said it before. I've said it to the bins. The bins agree with me."</div>
							</div>
						</div>

						<div class="carousel-slide" data-index="2">
							<div class="character-frame">
								<img
									src={sanityImg("https://cdn.sanity.io/images/8ksun996/production/87fee4d99ed54660972e1f7253091a621f4d4d24-896x1344.png", 460)}
									srcset={sanitySrcset("https://cdn.sanity.io/images/8ksun996/production/87fee4d99ed54660972e1f7253091a621f4d4d24-896x1344.png", 460)}
									sizes="(min-width: 900px) 460px, 320px"
									width="460"
									height="690"
									alt="Luna the Loner"
									class="hero-character"
									loading="lazy"
								/>
								<div class="character-ground-vignette"></div>
								<div class="character-nameplate">
									<div class="nameplate-name">Luna the Loner</div>
									<div class="nameplate-role">The Ghost</div>
								</div>
								<div class="character-tagline">"I don't have opinions about your plan. I have information."</div>
							</div>
						</div>

						<div class="carousel-slide" data-index="3">
							<div class="character-frame">
								<img
									src={sanityImg("https://cdn.sanity.io/images/8ksun996/production/e1ed30a067bbe4cff4f6b4962859557dd7fa103a-896x1344.png", 460)}
									srcset={sanitySrcset("https://cdn.sanity.io/images/8ksun996/production/e1ed30a067bbe4cff4f6b4962859557dd7fa103a-896x1344.png", 460)}
									sizes="(min-width: 900px) 460px, 320px"
									width="460"
									height="690"
									alt="Chubby Cheeks"
									class="hero-character"
									loading="lazy"
								/>
								<div class="character-ground-vignette"></div>
								<div class="character-nameplate">
									<div class="nameplate-name">Chubby Cheeks</div>
									<div class="nameplate-role">The Muscle</div>
								</div>
								<div class="character-tagline">"You don't just find snacks. You earn them. And by 'earn,' I mean you take them from the weak."</div>
							</div>
						</div>

						<div class="carousel-slide" data-index="4">
							<div class="character-frame">
								<img
									src={sanityImg("https://cdn.sanity.io/images/8ksun996/production/2058d4f4b5dff10ada3007a9c58828708cf2d685-896x1344.png", 460)}
									srcset={sanitySrcset("https://cdn.sanity.io/images/8ksun996/production/2058d4f4b5dff10ada3007a9c58828708cf2d685-896x1344.png", 460)}
									sizes="(min-width: 900px) 460px, 320px"
									width="460"
									height="690"
									alt="Gizmo the Genius"
									class="hero-character"
									loading="lazy"
								/>
								<div class="character-ground-vignette"></div>
								<div class="character-nameplate">
									<div class="nameplate-name">Gizmo the Genius</div>
									<div class="nameplate-role">The Inventor</div>
								</div>
								<div class="character-tagline">"Now, the beautiful thing about this is — oh, that's interesting. Actually, everyone move."</div>
							</div>
						</div>

						<div class="carousel-slide" data-index="5">
							<div class="character-frame">
								<img
									src={sanityImg("https://cdn.sanity.io/images/8ksun996/production/e323f904272aa43242549c2743913bdc24cb755c-896x1344.png", 460)}
									srcset={sanitySrcset("https://cdn.sanity.io/images/8ksun996/production/e323f904272aa43242549c2743913bdc24cb755c-896x1344.png", 460)}
									sizes="(min-width: 900px) 460px, 320px"
									width="460"
									height="690"
									alt="Trixie the Trickster"
									class="hero-character"
									loading="lazy"
								/>
								<div class="character-ground-vignette"></div>
								<div class="character-nameplate">
									<div class="nameplate-name">Trixie the Trickster</div>
									<div class="nameplate-role">The Artist</div>
								</div>
								<div class="character-tagline">"I don't make mistakes. I make unexpectedly vivid decisions."</div>
							</div>
						</div>

						<button class="carousel-arrow carousel-prev" id="carouselPrev" aria-label="Previous character">&#8592;</button>
						<button class="carousel-arrow carousel-next" id="carouselNext" aria-label="Next character">&#8594;</button>

						<div class="carousel-dots" id="carouselDots">
							<button class="carousel-dot active" data-dot="0" aria-label="Slide 1"></button>
							<button class="carousel-dot" data-dot="1" aria-label="Slide 2"></button>
							<button class="carousel-dot" data-dot="2" aria-label="Slide 3"></button>
							<button class="carousel-dot" data-dot="3" aria-label="Slide 4"></button>
							<button class="carousel-dot" data-dot="4" aria-label="Slide 5"></button>
							<button class="carousel-dot" data-dot="5" aria-label="Slide 6"></button>
							<button type="button" class="carousel-pause" id="carouselPause" aria-pressed="false">Pause</button>
						</div>
					</div>
				</div>

				<div class="hero-text-col fade-right hero-anim-immediate">
					{seriesLive && <div class="eyebrow">Now Streaming</div>}
					<h1 class="main-title">The Wildest Alley Cats<br>You'll Ever Meet</h1>
					<p class="hero-positioning">{positioningLine}</p>
					<p class="hero-body">A crew of street-savvy misfit cats. Rival gangs. Dark alleys. Glowing pipes. This is <strong>Cats On Crack</strong> — and they don't play by anyone's rules.</p>
					<div class="hero-ctas">
						{trailerId ? (
							<>
								<a href="#series" class="cta-button primary-cta">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
									Watch Our Trailer
								</a>
								<a href="/the-alley-squad" class="cta-button secondary-cta">
									Meet the Squad
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
								</a>
							</>
						) : (
							<>
								<a href="/the-alley-squad" class="cta-button primary-cta">
									Meet the Squad
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
								</a>
								<a href={subscribeUrl} target="_blank" rel="noopener noreferrer" class="cta-button secondary-cta">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
									Subscribe on YouTube
								</a>
							</>
						)}
					</div>
					<div class="hero-stats stagger-children">
						<div class="stat">
							<span class="stat-number">{characterCount}</span>
							<span class="stat-label">Characters</span>
						</div>
						<div class="stat-divider"></div>
						<div class="stat">
							<span class="stat-number">Dark</span>
							<span class="stat-label">Comedy</span>
						</div>
						<div class="stat-divider"></div>
						<div class="stat">
							<span class="stat-number">Adults</span>
							<span class="stat-label">Only</span>
						</div>
					</div>
				</div>
			</div>

			<div class="hero-bottom-fade"></div>
		</section>

		

		<section id="series" class="section series-section">
			<div class="container">
				<div class="series-grid">
					<div class="series-media-col">
						{trailerId ? (
							<>
								<div class="series-media" id="seriesTrailer">
									<img
										src={localImg(seriesPoster.src, 640)}
										srcset={localSrcset(seriesPoster.src, 640, seriesPoster.width)}
										sizes="(min-width: 900px) 560px, 100vw"
										width="1280"
										height="720"
										loading="lazy"
										alt="Cats On Crack trailer"
										class="series-media-img"
									/>
									<div class="series-scanlines" aria-hidden="true"></div>
									<button type="button" class="series-play-btn" aria-label="Play trailer (loads from YouTube)">
										<svg viewBox="0 0 24 24" fill="white" width="28" height="28" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
									</button>
								</div>
								<p class="video-note">Plays from YouTube, which may set cookies.</p>
							</>
						) : (
							<div class="series-media">
								<img
									src={localImg(seriesPoster.src, 640)}
									srcset={localSrcset(seriesPoster.src, 640, seriesPoster.width)}
									sizes="(min-width: 900px) 560px, 100vw"
									width="1392"
									height="752"
									loading="lazy"
									alt="A black-and-white alley cat legging it down a back alley with an armful of stolen fish, chased by a furious chef with a knife"
									class="series-media-img"
								/>
								<div class="series-scanlines" aria-hidden="true"></div>
							</div>
						)}
					</div>

					<div class="series-text-col">
						{seriesLive ? (
							<>
								<div class="series-eyebrow">Now Streaming</div>
								<h2 class="series-heading">Series 1 Is Out</h2>
								<p class="series-body">Episodes are up on YouTube now. Pull up a bin.</p>
								<div class="series-ctas">
									<a href={youtubeChannelUrl} target="_blank" rel="noopener noreferrer" class="primary-cta">Watch Now</a>
									<a href={subscribeUrl} target="_blank" rel="noopener noreferrer" class="secondary-cta">Subscribe &rarr;</a>
								</div>
							</>
						) : (
							<>
								<div class="series-eyebrow">{trailerId ? 'Trailer Out Now' : 'The Animated Series'}</div>
								<h2 class="series-heading">Series 1 Is on the Way</h2>
								<p class="series-body">
									{trailerId
										? "Watch the trailer, then subscribe on YouTube so you're first in the alley when the full series drops."
										: "The cats are in the edit. Some of them are refusing to come out. Subscribe on YouTube and you'll know the second it drops."}
								</p>
								<div class="series-ctas">
									<a href={subscribeUrl} target="_blank" rel="noopener noreferrer" class="primary-cta">Subscribe on YouTube</a>
								</div>
							</>
						)}
					</div>
				</div>
			</div>
		</section>

		{trailerId && (
			<script define:vars={{ trailerId }}>
				(function () {
					// Click-to-load: nothing is requested from YouTube until the visitor
					// presses play (the poster is self-hosted).
					const wrap = document.getElementById('seriesTrailer');
					if (!wrap) return;
					wrap.addEventListener('click', function () {
						wrap.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/' + trailerId + '?autoplay=1&rel=0" title="Cats On Crack trailer" frameborder="0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;inset:0;width:100%;height:100%;border-radius:12px;"></iframe>';
						wrap.querySelector('iframe')?.focus();
					});
				})();
			</script>
		)}

		<SectionDivider variant="spray" />

		<section id="squad" class="section squad-section">
			<div class="container">
				<div class="squad-header">
					<p class="squad-eyebrow">The Wider Crew</p>
					<h2 class="section-title glow-text">Everyone Else in the Alley</h2>
					<p class="squad-intro">Six of them get the posters. These lot get the blame.</p>
				</div>

				<ul class="squad-grid">
					{squad.map((char) => (
						<li>
							<a href={`/the-alley-squad#${char.slug}`} class="squad-card">
								<div class="squad-card-img-wrap">
									{char.image && (
										<img
											src={sanityImg(char.image, 400, { h: 600 })}
											srcset={[280, 400, 600, 800].map((w) => `${sanityImg(char.image, w, { h: w * 1.5 })} ${w}w`).join(', ')}
											sizes="(min-width: 1024px) 360px, (min-width: 768px) 45vw, 90vw"
											width="400"
											height="600"
											alt=""
											class="squad-card-img"
											loading="lazy"
										/>
									)}
								</div>
								<div class="squad-card-body">
									<p class="squad-card-role">{char.role}</p>
									<p class="squad-card-name">{char.name}</p>
									{char.line && <p class="squad-card-line">"{char.line}"</p>}
								</div>
							</a>
						</li>
					))}
				</ul>

				<p class="squad-footnote">That's just the start — {characterCount} cats, crooks and creatures in the alley.</p>
				<div class="squad-cta">
					<a href="/the-alley-squad" class="cta-button secondary">Meet The Gang</a>
				</div>
			</div>
		</section>

		{alleyCards.length > 0 && (
			<>
				<SectionDivider variant="crack" flip={true} />

				<section class="section alley-section" id="the-alley">
					<div class="container">
						<div class="alley-header">
							<p class="squad-eyebrow">The World</p>
							<h2 class="section-title glow-text">Welcome to the Alley</h2>
							<p class="alley-body">
								Meowtown's back end. Bins, pipes and grudges older than most of the residents. Nobody's in charge. Several cats think they are.
							</p>
						</div>

						<div class="alley-location-grid">
							{alleyCards.map((card) => card.hasDrawer ? (
								<button
									type="button"
									class="location-card location-card--button"
									style={`background-image: url('${card.image}');`}
									data-alley-open={card.slug}
									aria-haspopup="dialog"
									aria-controls={`alley-drawer-${card.slug}`}
								>
									<span class="location-card-overlay"></span>
									<span class="location-card-marker" aria-hidden="true">+</span>
									<span class="location-card-content">
										<span class="location-card-name">{card.name}</span>
										<span class="location-card-tagline">{card.tagline}</span>
									</span>
								</button>
							) : (
								<div
									class="location-card"
									style={`background-image: url('${card.image}');`}
									role="img"
									aria-label={card.alt}
								>
									<div class="location-card-overlay"></div>
									<div class="location-card-content">
										<span class="location-card-name">{card.name}</span>
										<span class="location-card-tagline">{card.tagline}</span>
									</div>
								</div>
							))}
						</div>
					</div>

					{alleyCards.filter((card) => card.hasDrawer).map((card) => (
						<dialog class="alley-drawer" id={`alley-drawer-${card.slug}`} data-alley-drawer={card.slug} aria-labelledby={`alley-drawer-title-${card.slug}`}>
							<div class="alley-drawer-panel">
								<button type="button" class="alley-drawer-close" data-alley-close aria-label="Close">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
								</button>
								{card.drawerImage && (
									<img class="alley-drawer-img" src={card.drawerImage} alt={card.alt} width="960" height="544" loading="lazy" />
								)}
								<div class="alley-drawer-body">
									<p class="squad-eyebrow">Meowtown</p>
									<h2 class="alley-drawer-title" id={`alley-drawer-title-${card.slug}`}>{card.name}</h2>
									<p class="alley-drawer-tagline">{card.tagline}</p>
									<div class="alley-drawer-desc">
										<PortableText value={card.description} />
									</div>

									{card.residents.length > 0 && (
										<div class="alley-drawer-group">
											<h3 class="alley-drawer-subhead">Who Lives Here</h3>
											<ul class="alley-chips">
												{card.residents.map((r: any) => (
