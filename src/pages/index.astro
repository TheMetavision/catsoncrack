		transform: translateY(-4px);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
	}

	.location-card-overlay {
		position: absolute;
		inset: 0;
		display: block;
		background: linear-gradient(180deg, rgba(24, 27, 34, 0.3) 0%, rgba(24, 27, 34, 0.92) 100%);
		pointer-events: none;
	}

	.location-card-marker {
		position: absolute;
		top: 14px;
		right: 18px;
		z-index: 2;
		font-family: 'Bebas Neue', 'Impact', sans-serif;
		font-size: 1.8rem;
		line-height: 1;
		color: rgba(255, 255, 255, 0.9);
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
	}

	.location-card-content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.location-card-name {
		font-family: 'Bebas Neue', 'Impact', sans-serif;
		font-size: 1.6rem;
		letter-spacing: 2px;
		color: #fff;
		line-height: 1;
	}

	.location-card-tagline {
		font-size: 0.9rem;
		line-height: 1.45;
		color: rgba(255, 255, 255, 0.82);
	}

	.location-card--button {
		width: 100%;
		font: inherit;
		color: inherit;
		text-align: left;
		cursor: pointer;
	}

	.location-card--button:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 3px;
		border-color: var(--primary);
	}

	.alley-drawer {
		padding: 0;
		border: none;
		background: transparent;
		color: #fff;
		/* Right-hand panel on wide screens, full width on phones. */
		margin: 0 0 0 auto;
		width: min(480px, 100%);
		max-width: 100%;
		height: 100dvh;
		max-height: 100dvh;
		overflow: hidden;
	}

	.alley-drawer::backdrop {
		background: rgba(0, 0, 0, 0.6);
	}

	.alley-drawer[open] .alley-drawer-panel {
		animation: alley-drawer-in 0.28s ease-out;
	}

	.alley-drawer[open]::backdrop {
		animation: alley-backdrop-in 0.28s ease-out;
	}

	@keyframes alley-drawer-in {
		from { transform: translateX(100%); }
		to { transform: translateX(0); }
	}

	@keyframes alley-backdrop-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	.alley-drawer-panel {
		position: relative;
		height: 100%;
		overflow-y: auto;
		overscroll-behavior: contain;
		background: var(--bg-card);
		border-left: 3px solid var(--primary);
		box-shadow: -12px 0 40px rgba(0, 0, 0, 0.45);
	}

	.alley-drawer-close {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 2;
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.3);
		background: rgba(24, 27, 34, 0.85);
		color: #fff;
	}

	.alley-drawer-close:hover {
		background: var(--primary);
		border-color: var(--primary);
	}

	.alley-drawer-close:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 2px;
	}

	.alley-drawer-img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 960 / 544;
		object-fit: cover;
	}

	.alley-drawer-body {
		padding: 24px 28px 40px;
	}

	.alley-drawer-title {
		font-size: clamp(2rem, 5vw, 2.6rem);
		line-height: 1;
		letter-spacing: 2px;
		color: #fff;
		margin: 0 0 8px;
	}

	.alley-drawer-tagline {
		font-style: italic;
		color: var(--primary);
		margin: 0 0 20px;
	}

	.alley-drawer-desc :global(p) {
		color: rgba(255, 255, 255, 0.78);
		font-size: 1rem;
		line-height: 1.7;
		margin: 0 0 14px;
	}

	.alley-drawer-group {
		margin-top: 28px;
	}

	.alley-drawer-subhead {
		font-family: 'Inter', sans-serif;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 3px;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.6);
		margin: 0 0 12px;
	}

	.alley-chips {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.alley-chip {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		padding: 6px 14px;
		border-radius: 999px;
		border: 1px solid rgba(255, 0, 255, 0.6);
		background: rgba(255, 0, 255, 0.12);
		color: #fff;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.alley-products {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 12px;
	}

	.alley-product {
		display: flex;
		flex-direction: column;
		gap: 8px;
		height: 100%;
		padding: 10px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 8px;
		background: var(--black);
		color: #fff;
	}

	.alley-product img {
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 4px;
		background: #fff;
	}

	.alley-product-name {
		font-size: 0.85rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.alley-chip:hover,
	.alley-chip:focus-visible {
		background: var(--primary);
		border-color: var(--primary);
		color: #fff;
		text-shadow: none;
	}

	.alley-product:hover,
	.alley-product:focus-visible {
		border-color: var(--primary);
		color: #fff;
		text-shadow: none;
	}

	.alley-chip:focus-visible,
	.alley-product:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 2px;
	}

	/* ── Books (from Sanity book docs) ──────────────────────── */
	.books-grid-wrap {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 56px;
		align-items: center;
	}

	.books-text p {
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--text-secondary);
		margin-bottom: 10px;
	}

	.book-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
	}

	.book-item {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.book-cover-wrap {
		position: relative;
	}

	.book-cover {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: 6px;
		border: 1px solid rgba(255, 0, 255, 0.2);
		box-shadow: 0 10px 32px rgba(0, 0, 0, 0.45);
	}

	.book-cover--blank {
		background: var(--bg-card);
	}

	.book-badge {
		position: absolute;
		top: 10px;
		left: 10px;
		background: var(--primary);
		color: #fff;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 2px;
		text-transform: uppercase;
		padding: 4px 9px;
		border-radius: 3px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
	}

	.book-title {
		margin: 0;
		font-family: 'Bebas Neue', 'Impact', sans-serif;
		font-size: 1.15rem;
		letter-spacing: 1px;
		color: #fff;
		line-height: 1.1;
	}

	.book-buy {
		align-self: flex-start;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: #fff;
		border-bottom: 2px solid var(--primary);
	}

	@media (max-width: 1024px) {
		.squad-grid,
		.alley-location-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 900px) {
		.series-grid,
		.books-grid-wrap {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.series-text-col,
		.books-text {
			text-align: center;
		}

		.series-ctas {
			justify-content: center;
		}
	}

	@media (max-width: 600px) {
		.squad-grid,
		.alley-location-grid {
			grid-template-columns: 1fr;
		}

		.location-card {
			min-height: 180px;
		}

		.book-grid {
			gap: 10px;
		}

		.alley-drawer-panel {
			border-left: none;
		}

		.alley-drawer-body {
			padding: 20px 18px 32px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.alley-drawer[open] .alley-drawer-panel,
		.alley-drawer[open]::backdrop {
			animation: none;
		}

		.location-card,
		.location-card:hover,
		.squad-card,
		.squad-card:hover,
		.squad-card:focus-visible,
		.squad-card-img,
		.squad-card:hover .squad-card-img,
		.series-media-img,
		#seriesTrailer:hover .series-media-img {
			transition: none;
			transform: none;
		}
	}

	.newsletter-section {
		padding: 120px 0;
	}

	.newsletter-content {
		display: flex;
		flex-direction: column;
		gap: 40px;
		align-items: center;
		background: var(--bg-card);
		border-radius: 20px;
		padding: 0;
		box-shadow: 0 10px 50px rgba(0, 0, 0, 0.5);
		border: 2px solid rgba(255, 0, 255, 0.2);
		overflow: hidden;
		max-width: 900px;
		margin: 0 auto;
	}

	.newsletter-image {
		width: 100%;
		border-radius: 0;
		overflow: hidden;
	}

	.newsletter-image img {
		width: 100%;
		height: auto;
		display: block;
	}

	.newsletter-text {
		padding: 0 60px 60px;
		text-align: center;
	}

	.newsletter-text h2 {
		font-size: clamp(1.8rem, 3vw, 2.5rem);
		margin-bottom: 15px;
		color: var(--primary);
	}

	.subtitle {
		font-size: 1rem;
		color: var(--text-secondary);
		margin-bottom: 30px;
		text-transform: uppercase;
		letter-spacing: 2px;
	}

	.newsletter-form {
		display: flex;
		gap: 15px;
		flex-wrap: wrap;
	}

	.email-input {
		flex: 1;
		min-width: 250px;
		padding: 15px 20px;
		background: var(--bg-darker);
		border: 2px solid rgba(255, 0, 255, 0.3);
		border-radius: 8px;
		color: var(--text-primary);
		font-size: 1rem;
		transition: all 0.3s ease;
	}

	.email-input:focus {
		outline: none;
		border-color: var(--primary);
		box-shadow: 0 0 0 3px rgba(255, 0, 255, 0.1);
	}

	/* newsletter-image styles defined above with newsletter-content */

	/* Newsletter confirmation card */
	.nl-signal {
		display: flex;
		align-items: center;
		gap: 14px;
		background: var(--bg-darker, #0d0f14);
		border: 2px solid rgba(255, 0, 255, 0.2);
		border-left: 4px solid var(--primary, #ff00ff);
		border-radius: 12px;
		padding: 1.25rem 1.5rem;
		text-align: left;
		animation: nlSignalIn 0.4s ease-out;
	}

	@keyframes nlSignalIn {
		from { opacity: 0; transform: translateY(8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.nl-signal__badge {
		flex-shrink: 0;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: var(--primary, #ff00ff);
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 0 15px rgba(255, 0, 255, 0.4);
	}

	.nl-signal__label {
		font-family: 'Bebas Neue', sans-serif;
		font-size: 0.625rem;
		color: var(--primary, #ff00ff);
		letter-spacing: 2.5px;
		margin-bottom: 3px;
		text-transform: uppercase;
		text-shadow: 0 0 8px rgba(255, 0, 255, 0.3);
	}

	.nl-signal__headline {
		font-family: 'Bebas Neue', sans-serif;
		color: #fff;
		font-size: 1.2rem;
		letter-spacing: 1.5px;
		line-height: 1.3;
		text-transform: uppercase;
		text-shadow: 2px 2px 0 rgba(255, 0, 255, 0.15);
	}

	.nl-signal__sub {
		font-family: 'Inter', sans-serif;
		color: var(--text-secondary, rgba(255,255,255,0.5));
