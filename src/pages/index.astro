	}

	@media (max-width: 1100px) {
		.hero-split {
			gap: 36px;
		}
	}

	@media (max-width: 900px) {
		.hero-text-col { padding-bottom: 0; }
	}

	@media (max-width: 968px) {
		.pillars {
			grid-template-columns: 1fr;
		}

		.pillar-divider {
			width: auto;
			height: 1px;
			background: linear-gradient(
				to right,
				transparent 0%,
				rgba(255,0,255,0.3) 20%,
				rgba(255,0,255,0.3) 80%,
				transparent 100%
			);
		}

		.pillar {
			padding: 40px 32px;
		}

		.newsletter-text {
			padding: 0 30px 40px;
		}
	}

	@media (max-width: 768px) {
		.hero-ctas {
			flex-direction: column;
		}

		.hero-ctas .primary-cta,
		.hero-ctas .secondary-cta {
			width: 100%;
			justify-content: center;
			text-align: center;
		}

		.hero-stats {
			gap: 16px;
		}

		.newsletter-content {
			padding: 40px 30px;
		}

		.newsletter-form {
			flex-direction: column;
		}

		.email-input {
			width: 100%;
