		height: 120px;
		background: linear-gradient(to top, #181b22 0%, transparent 100%);
		z-index: 3;
		pointer-events: none;
	}

	.description {
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--text-secondary);
	}

	.description p {
		margin-bottom: 20px;
	}

	.description strong {
		color: var(--text-primary);
		font-weight: 700;
	}

	.highlight {
		padding-left: 20px;
		border-left: 4px solid var(--primary);
	}

	.tagline {
		font-size: 1.2rem;
		color: var(--text-primary);
		font-weight: 600;
		margin-top: 30px;
	}

	.cta-button {
		display: inline-block;
		padding: 16px 40px;
		background: var(--accent-gradient);
		color: white;
		font-size: 1.3rem;
		font-weight: 900;
		letter-spacing: 2px;
		border-radius: 8px;
		margin-top: 30px;
		text-transform: uppercase;
		box-shadow: 0 4px 20px rgba(255, 0, 255, 0.4);
		transition: all 0.3s ease;
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
	}

	.cta-button:hover {
		transform: translateY(-3px);
		box-shadow: var(--glow-strong);
		color: white;
	}

	.cta-button.secondary {
		background: transparent;
		border: 3px solid var(--primary);
		color: var(--primary);
	}

	.cta-button.secondary:hover {
		background: var(--primary);
		color: white;
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 25px;
		line-height: 1.2;
		color: var(--primary);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.hero-positioning {
		font-size: 1.2rem;
		line-height: 1.6;
		color: #fff;
		margin: -8px 0 18px;
		max-width: 480px;
	}

	/* ── Series (trailer or "on the way") ───────────────────── */
	.series-grid {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 56px;
		align-items: center;
	}

	.series-media {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 12px;
		overflow: hidden;
		border: 2px solid rgba(255, 0, 255, 0.2);
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
		background: #000;
	}

	#seriesTrailer {
		cursor: pointer;
	}

	.series-media-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease, filter 0.3s ease;
	}

	#seriesTrailer:hover .series-media-img {
		transform: scale(1.03);
		filter: brightness(0.8);
	}

	.series-scanlines {
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(to bottom, transparent, transparent 2px, rgba(0, 0, 0, 0.15) 2px, rgba(0, 0, 0, 0.15) 3px);
		pointer-events: none;
		z-index: 1;
	}

	.series-play-btn {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		z-index: 2;
		width: 68px;
		height: 68px;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.6);
		border: 2px solid rgba(255, 255, 255, 0.85);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
	}

	.series-play-btn svg {
		margin-left: 4px;
	}

	#seriesTrailer:hover .series-play-btn,
	.series-play-btn:focus-visible {
		background: rgba(255, 0, 255, 0.85);
		border-color: #fff;
		transform: translate(-50%, -50%) scale(1.08);
	}

	.series-play-btn:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 3px;
	}

	.video-note {
		margin: 10px 0 0;
		font-size: 0.78rem;
		color: rgba(255, 255, 255, 0.55);
		text-align: center;
	}

	.series-eyebrow,
	.squad-eyebrow {
		font-family: 'Inter', sans-serif;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 4px;
		text-transform: uppercase;
		color: var(--primary);
		margin-bottom: 14px;
	}

	.series-heading {
		font-size: clamp(2.2rem, 4vw, 3.2rem);
		color: #fff;
		line-height: 1.05;
		letter-spacing: 2px;
		margin-bottom: 18px;
	}

	.series-body {
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--text-secondary);
		margin-bottom: 28px;
	}

	.series-ctas {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
	}

	/* ── Squad grid (the wider crew) ────────────────────────── */
	.squad-header,
	.alley-header {
		text-align: center;
		max-width: 720px;
		margin: 0 auto 48px;
	}

	.squad-intro,
	.alley-body {
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--text-secondary);
		margin: 0;
	}

	.squad-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.squad-card {
		height: 100%;
		display: flex;
		flex-direction: column;
		background: var(--bg-card);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
	}

	.squad-card:hover,
	.squad-card:focus-visible {
		border-color: var(--primary);
		transform: translateY(-4px);
		box-shadow: 0 8px 28px rgba(255, 0, 255, 0.2);
		text-shadow: none;
	}

	.squad-card:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 3px;
	}

	.squad-card-img-wrap {
		aspect-ratio: 2 / 3;
		overflow: hidden;
		background: var(--bg-darker, #0d0f14);
	}

	.squad-card-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		display: block;
		transition: transform 0.3s ease;
	}

	.squad-card:hover .squad-card-img {
		transform: scale(1.03);
	}

	.squad-card-body {
		padding: 20px;
	}

	.squad-card-role {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 3px;
		text-transform: uppercase;
		color: var(--primary);
		margin-bottom: 6px;
	}

	.squad-card-name {
		font-family: 'Bebas Neue', 'Impact', sans-serif;
		font-size: 1.7rem;
		letter-spacing: 2px;
		color: #fff;
		line-height: 1;
		margin-bottom: 10px;
	}

	.squad-card-line {
		font-size: 0.9rem;
		font-style: italic;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.6);
		margin: 0;
	}

	.squad-footnote {
		color: var(--text-secondary);
		font-size: 1rem;
		text-align: center;
		margin: 40px 0 0;
	}

	.squad-cta {
		text-align: center;
	}

	/* ── The Alley: location cards + drawer ─────────────────── */
	.alley-location-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.location-card {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: 240px;
		padding: 36px 28px 32px;
		background-color: var(--bg-card);
		background-size: cover;
		background-position: center;
		border: 1px solid rgba(255, 0, 255, 0.35);
		border-radius: 12px;
		overflow: hidden;
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}

	.location-card:hover {
		border-color: var(--primary);
		transform: translateY(-4px);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
	}

	.location-card-overlay {
		position: absolute;
		inset: 0;
		display: block;
		background: linear-gradient(180deg, rgba(24, 27, 34, 0.3) 0%, rgba(24, 27, 34, 0.92) 100%);
		pointer-events: none;
	}

	.location-card-marker {
		position: absolute;
		top: 14px;
		right: 18px;
		z-index: 2;
		font-family: 'Bebas Neue', 'Impact', sans-serif;
		font-size: 1.8rem;
		line-height: 1;
		color: rgba(255, 255, 255, 0.9);
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
	}

	.location-card-content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.location-card-name {
		font-family: 'Bebas Neue', 'Impact', sans-serif;
		font-size: 1.6rem;
		letter-spacing: 2px;
		color: #fff;
		line-height: 1;
	}

	.location-card-tagline {
		font-size: 0.9rem;
		line-height: 1.45;
		color: rgba(255, 255, 255, 0.82);
	}

	.location-card--button {
		width: 100%;
		font: inherit;
		color: inherit;
		text-align: left;
		cursor: pointer;
	}

	.location-card--button:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 3px;
		border-color: var(--primary);
	}

	.alley-drawer {
		padding: 0;
		border: none;
		background: transparent;
		color: #fff;
		/* Right-hand panel on wide screens, full width on phones. */
		margin: 0 0 0 auto;
		width: min(480px, 100%);
		max-width: 100%;
		height: 100dvh;
		max-height: 100dvh;
		overflow: hidden;
	}

	.alley-drawer::backdrop {
		background: rgba(0, 0, 0, 0.6);
	}

	.alley-drawer[open] .alley-drawer-panel {
		animation: alley-drawer-in 0.28s ease-out;
	}

	.alley-drawer[open]::backdrop {
		animation: alley-backdrop-in 0.28s ease-out;
	}

	@keyframes alley-drawer-in {
		from { transform: translateX(100%); }
		to { transform: translateX(0); }
	}

	@keyframes alley-backdrop-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	.alley-drawer-panel {
		position: relative;
		height: 100%;
		overflow-y: auto;
		overscroll-behavior: contain;
		background: var(--bg-card);
		border-left: 3px solid var(--primary);
		box-shadow: -12px 0 40px rgba(0, 0, 0, 0.45);
	}

	.alley-drawer-close {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 2;
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.3);
		background: rgba(24, 27, 34, 0.85);
		color: #fff;
	}

	.alley-drawer-close:hover {
		background: var(--primary);
		border-color: var(--primary);
	}

	.alley-drawer-close:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 2px;
	}

	.alley-drawer-img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 960 / 544;
		object-fit: cover;
	}

	.alley-drawer-body {
		padding: 24px 28px 40px;
	}

	.alley-drawer-title {
		font-size: clamp(2rem, 5vw, 2.6rem);
		line-height: 1;
		letter-spacing: 2px;
		color: #fff;
		margin: 0 0 8px;
	}

	.alley-drawer-tagline {
		font-style: italic;
		color: var(--primary);
		margin: 0 0 20px;
	}

	.alley-drawer-desc :global(p) {
		color: rgba(255, 255, 255, 0.78);
		font-size: 1rem;
		line-height: 1.7;
		margin: 0 0 14px;
	}

	.alley-drawer-group {
		margin-top: 28px;
	}

	.alley-drawer-subhead {
		font-family: 'Inter', sans-serif;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 3px;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.6);
		margin: 0 0 12px;
	}

	.alley-chips {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.alley-chip {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		padding: 6px 14px;
		border-radius: 999px;
		border: 1px solid rgba(255, 0, 255, 0.6);
		background: rgba(255, 0, 255, 0.12);
		color: #fff;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.alley-products {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 12px;
	}

	.alley-product {
		display: flex;
		flex-direction: column;
		gap: 8px;
		height: 100%;
		padding: 10px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 8px;
		background: var(--black);
		color: #fff;
	}

	.alley-product img {
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 4px;
		background: #fff;
	}

	.alley-product-name {
		font-size: 0.85rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.alley-chip:hover,
	.alley-chip:focus-visible {
		background: var(--primary);
		border-color: var(--primary);
		color: #fff;
		text-shadow: none;
	}

	.alley-product:hover,
	.alley-product:focus-visible {
		border-color: var(--primary);
		color: #fff;
		text-shadow: none;
	}

	.alley-chip:focus-visible,
	.alley-product:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 2px;
	}

	/* ── Books (from Sanity book docs) ──────────────────────── */
	.books-grid-wrap {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 56px;
		align-items: center;
	}

	.books-text p {
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--text-secondary);
		margin-bottom: 10px;
	}

	.book-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
	}

	.book-item {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.book-cover-wrap {
		position: relative;
	}

	.book-cover {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: 6px;
		border: 1px solid rgba(255, 0, 255, 0.2);
		box-shadow: 0 10px 32px rgba(0, 0, 0, 0.45);
	}

	.book-cover--blank {
		background: var(--bg-card);
	}

	.book-badge {
		position: absolute;
		top: 10px;
		left: 10px;
		background: var(--primary);
		color: #fff;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 2px;
		text-transform: uppercase;
		padding: 4px 9px;
		border-radius: 3px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
	}

	.book-title {
		margin: 0;
		font-family: 'Bebas Neue', 'Impact', sans-serif;
		font-size: 1.15rem;
		letter-spacing: 1px;
		color: #fff;
		line-height: 1.1;
	}

	.book-buy {
		align-self: flex-start;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: #fff;
		border-bottom: 2px solid var(--primary);
	}

	@media (max-width: 1024px) {
		.squad-grid,
		.alley-location-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 900px) {
		.series-grid,
		.books-grid-wrap {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.series-text-col,
		.books-text {
			text-align: center;
		}

		.series-ctas {
			justify-content: center;
		}
	}

	@media (max-width: 600px) {
		.squad-grid,
		.alley-location-grid {
			grid-template-columns: 1fr;
		}

		.location-card {
			min-height: 180px;
		}

		.book-grid {
			gap: 10px;
		}

		.alley-drawer-panel {
			border-left: none;
		}

		.alley-drawer-body {
			padding: 20px 18px 32px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.alley-drawer[open] .alley-drawer-panel,
		.alley-drawer[open]::backdrop {
			animation: none;
		}

		.location-card,
		.location-card:hover,
		.squad-card,
		.squad-card:hover,
		.squad-card:focus-visible,
		.squad-card-img,
		.squad-card:hover .squad-card-img,
		.series-media-img,
		#seriesTrailer:hover .series-media-img {
			transition: none;
			transform: none;
		}
	}

	.newsletter-section {
		padding: 120px 0;
	}

	.newsletter-content {
		display: flex;
		flex-direction: column;
		gap: 40px;
		align-items: center;
		background: var(--bg-card);
		border-radius: 20px;
		padding: 0;
		box-shadow: 0 10px 50px rgba(0, 0, 0, 0.5);
		border: 2px solid rgba(255, 0, 255, 0.2);
		overflow: hidden;
		max-width: 900px;
		margin: 0 auto;
	}

	.newsletter-image {
		width: 100%;
		border-radius: 0;
		overflow: hidden;
	}

	.newsletter-image img {
		width: 100%;
		height: auto;
		display: block;
	}

	.newsletter-text {
		padding: 0 60px 60px;
		text-align: center;
	}

	.newsletter-text h2 {
		font-size: clamp(1.8rem, 3vw, 2.5rem);
		margin-bottom: 15px;
		color: var(--primary);
	}

	.subtitle {
		font-size: 1rem;
		color: var(--text-secondary);
		margin-bottom: 30px;
		text-transform: uppercase;
		letter-spacing: 2px;
	}

	.newsletter-form {
		display: flex;
		gap: 15px;
		flex-wrap: wrap;
	}

	.email-input {
		flex: 1;
		min-width: 250px;
		padding: 15px 20px;
		background: var(--bg-darker);
		border: 2px solid rgba(255, 0, 255, 0.3);
		border-radius: 8px;
		color: var(--text-primary);
		font-size: 1rem;
		transition: all 0.3s ease;
	}

	.email-input:focus {
		outline: none;
		border-color: var(--primary);
		box-shadow: 0 0 0 3px rgba(255, 0, 255, 0.1);
	}

	/* newsletter-image styles defined above with newsletter-content */

	/* Newsletter confirmation card */
	.nl-signal {
		display: flex;
		align-items: center;
		gap: 14px;
		background: var(--bg-darker, #0d0f14);
		border: 2px solid rgba(255, 0, 255, 0.2);
		border-left: 4px solid var(--primary, #ff00ff);
		border-radius: 12px;
		padding: 1.25rem 1.5rem;
		text-align: left;
		animation: nlSignalIn 0.4s ease-out;
	}

	@keyframes nlSignalIn {
		from { opacity: 0; transform: translateY(8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.nl-signal__badge {
		flex-shrink: 0;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: var(--primary, #ff00ff);
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 0 15px rgba(255, 0, 255, 0.4);
	}

	.nl-signal__label {
		font-family: 'Bebas Neue', sans-serif;
		font-size: 0.625rem;
		color: var(--primary, #ff00ff);
		letter-spacing: 2.5px;
		margin-bottom: 3px;
		text-transform: uppercase;
		text-shadow: 0 0 8px rgba(255, 0, 255, 0.3);
	}

	.nl-signal__headline {
		font-family: 'Bebas Neue', sans-serif;
		color: #fff;
		font-size: 1.2rem;
		letter-spacing: 1.5px;
		line-height: 1.3;
		text-transform: uppercase;
		text-shadow: 2px 2px 0 rgba(255, 0, 255, 0.15);
	}

	.nl-signal__sub {
		font-family: 'Inter', sans-serif;
		color: var(--text-secondary, rgba(255,255,255,0.5));
		font-size: 0.8rem;
		margin-top: 3px;
	}

	@media (max-width: 1100px) {
		.hero-split {
			gap: 36px;
		}
	}

	@media (max-width: 900px) {
		.hero-split {
			grid-template-columns: 1fr;
			align-items: center;
			gap: 0;
		}

		.hero-image-col {
			order: 1;
		}

		.hero-text-col {
			order: 2;
			padding-bottom: 0;
			padding-top: 16px;
		}

		.hero-character {
			max-width: 320px;
			margin: 0 auto;
		}

		.hero-character-svg {
			max-width: 320px;
		}

		.character-nameplate {
			bottom: 60px;
		}

		.character-tagline {
			top: 16px;
		}
	}

	@media (max-width: 968px) {
		.pillars {
			grid-template-columns: 1fr;
		}

		.pillar-divider {
			width: auto;
			height: 1px;
			background: linear-gradient(
				to right,
				transparent 0%,
				rgba(255,0,255,0.3) 20%,
				rgba(255,0,255,0.3) 80%,
				transparent 100%
			);
		}

		.pillar {
			padding: 40px 32px;
		}

		.newsletter-text {
			padding: 0 30px 40px;
		}
	}

	@media (max-width: 768px) {
		.hero {
			padding-top: 110px;
			padding-bottom: 40px;
		}

		.hero-ctas {
			flex-direction: column;
		}

		.hero-ctas .primary-cta,
		.hero-ctas .secondary-cta {
			width: 100%;
			justify-content: center;
			text-align: center;
		}

		.hero-stats {
			gap: 16px;
		}

		.newsletter-content {
			padding: 40px 30px;
		}

		.newsletter-form {
			flex-direction: column;
		}

		.email-input {
			width: 100%;
		}
	}
</style>

<script>
	const form = document.getElementById('newsletterForm');
	const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
	const nlConfirm = document.getElementById('nl-confirm');

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const email = form.querySelector('input[type="email"]') as HTMLInputElement;
		if (!email?.value) return;

		const originalText = btn.textContent;
		btn.textContent = 'Subscribing...';
		btn.disabled = true;

		try {
			const res = await fetch('/api/subscribe', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: email.value })
			});
			const data = await res.json().catch(() => ({}));

			if (res.ok && data.ok) {
				form.style.display = 'none';
				if (nlConfirm) {
					if (data.already) {
						const signal = nlConfirm.querySelector('.nl-signal');
						if (signal) {
							signal.querySelector('.nl-signal__label')!.textContent = 'Already in the alley';
							signal.querySelector('.nl-signal__headline')!.textContent = 'We know you, stray.';
							signal.querySelector('.nl-signal__sub')!.textContent = "You signed up before. The crew's already got you covered.";
						}
					}
					nlConfirm.style.display = 'block';
				}
			} else {
				throw new Error('Subscription failed');
			}
		} catch (err) {
			btn.textContent = 'Something went wrong — try again';
			btn.disabled = false;
			setTimeout(() => { btn.textContent = originalText; }, 3000);
		}
	});
	// Listening now; the button was rendered disabled until this point.
	if (btn) btn.disabled = false;

	(function() {
		const carousel = document.getElementById('heroCarousel');
		if (!carousel) return;

		const slides = carousel.querySelectorAll('.carousel-slide');
		const dots = carousel.querySelectorAll('.carousel-dot');
		const prevBtn = document.getElementById('carouselPrev');
		const nextBtn = document.getElementById('carouselNext');
		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;
		// Stopped by the Pause button, or from the start under reduced motion;
		// hover and focus pause it only while they last.
		let stopped = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let held = false;
		const pauseBtn = document.getElementById('carouselPause');

		function goTo(index: number) {
			slides[current].classList.remove('active');
			dots[current].classList.remove('active');
			current = (index + slides.length) % slides.length;
			slides[current].classList.add('active');
			dots[current].classList.add('active');
		}

		function startTimer() {
			clearInterval(timer);
			if (stopped) return;
			timer = setInterval(() => { if (!held) goTo(current + 1); }, 4000);
		}

		function paintPause() {
			if (!pauseBtn) return;
			pauseBtn.textContent = stopped ? 'Play' : 'Pause';
			pauseBtn.setAttribute('aria-pressed', String(stopped));
			pauseBtn.setAttribute('aria-label', stopped ? 'Start the character slideshow' : 'Stop the character slideshow');
		}
		pauseBtn?.addEventListener('click', () => { stopped = !stopped; paintPause(); startTimer(); });
		carousel.addEventListener('mouseenter', () => { held = true; });
		carousel.addEventListener('mouseleave', () => { held = false; });
		carousel.addEventListener('focusin', () => { held = true; });
		carousel.addEventListener('focusout', () => { held = false; });
		paintPause();

		function resetTimer() {
			clearInterval(timer);
			startTimer();
		}

		prevBtn?.addEventListener('click', () => { goTo(current - 1); resetTimer(); });
		nextBtn?.addEventListener('click', () => { goTo(current + 1); resetTimer(); });

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				const idx = parseInt((dot as HTMLElement).dataset.dot || '0', 10);
				goTo(idx);
				resetTimer();
			});
		});

		startTimer();
	})();

	// ── The Alley drawer ─────────────────────────────────────
	// Only cards with a description render as buttons (and get a <dialog>); with
	// none, this finds nothing. The whole section is absent until a location
	// is featured on the homepage with an image.
	const ALLEY_HASH = '#the-alley/';
	const alleyDialogs = new Map<string, HTMLDialogElement>();
	document.querySelectorAll<HTMLDialogElement>('dialog[data-alley-drawer]').forEach((d) => {
		alleyDialogs.set(d.dataset.alleyDrawer!, d);
	});
	let alleyOpener: HTMLElement | null = null;
	let alleyOpenSlug: string | null = null;

	function alleyCardFor(slug: string) {
		return document.querySelector<HTMLElement>(`[data-alley-open="${CSS.escape(slug)}"]`);
	}

	function openAlley(slug: string, opener: HTMLElement | null) {
		const dialog = alleyDialogs.get(slug);
		if (!dialog || dialog.open) return;
		alleyDialogs.forEach((d, s) => { if (d.open) closeAlley(d, s); });
		alleyOpener = opener ?? alleyCardFor(slug);
		alleyOpenSlug = slug;
		dialog.showModal();
		dialog.querySelector<HTMLElement>('[data-alley-close]')?.focus();
		if (location.hash !== ALLEY_HASH + slug) {
			history.replaceState(null, '', ALLEY_HASH + slug);
		}
	}

	// Tidy up synchronously rather than waiting for the dialog's async 'close'
	// event (which a browser may defer, e.g. in a background tab); 'close' still
	// calls this as a fallback, so it must be safe to run twice.
	function closeAlley(dialog: HTMLDialogElement, slug: string) {
		if (dialog.open) dialog.close();
		if (alleyOpenSlug !== slug) return;
		alleyOpenSlug = null;
		if (location.hash === ALLEY_HASH + slug) {
			history.replaceState(null, '', location.pathname + location.search);
		}
		(alleyOpener ?? alleyCardFor(slug))?.focus();
		alleyOpener = null;
	}

	alleyDialogs.forEach((dialog, slug) => {
		dialog.addEventListener('close', () => closeAlley(dialog, slug));
		// Esc
		dialog.addEventListener('cancel', (e) => { e.preventDefault(); closeAlley(dialog, slug); });
		// A click on the dialog box itself (not the panel) is a backdrop click.
		dialog.addEventListener('click', (e) => { if (e.target === dialog) closeAlley(dialog, slug); });
		dialog.querySelector('[data-alley-close]')?.addEventListener('click', () => closeAlley(dialog, slug));
		dialog.addEventListener('keydown', (e) => {
			// Esc is handled here too, so closing never depends on the native 'cancel'.
			if (e.key === 'Escape') { e.preventDefault(); closeAlley(dialog, slug); return; }
			// Keep Tab inside the drawer.
			if (e.key !== 'Tab') return;
			const focusable = Array.from(dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
			if (!focusable.length) return;
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
			else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
		});
	});

	document.querySelectorAll<HTMLElement>('[data-alley-open]').forEach((card) => {
		card.addEventListener('click', () => openAlley(card.dataset.alleyOpen!, card));
	});

	function openAlleyFromHash() {
		if (!location.hash.startsWith(ALLEY_HASH)) return;
		const slug = decodeURIComponent(location.hash.slice(ALLEY_HASH.length));
		if (!alleyDialogs.has(slug)) return;
		alleyCardFor(slug)?.scrollIntoView({ block: 'center' });
		openAlley(slug, null);
	}
	window.addEventListener('hashchange', openAlleyFromHash);
	openAlleyFromHash();
</script>
