	/* ── HERO: copy on the left, the scene on the right ──
	   Wide screens: the scene box is 64% wide and keeps the art's 3:2 shape (the
	   section height follows the width), so nothing is cropped. Below 1025px the
	   scene fills the hero behind a shade; on phones it sits in a band above the copy. */
	.hero-scene {
		position: absolute;
		top: var(--nav-h, 108px);
		right: 0;
		width: 64%;
		height: calc(100% - var(--nav-h, 108px));
		object-fit: cover;
		object-position: 50% 45%;
		z-index: 0;
		-webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
		mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
	}
	.hero-shade {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			linear-gradient(90deg, rgba(14,15,20,0.92) 0%, rgba(14,15,20,0.6) 30%, rgba(14,15,20,0.05) 50%, transparent 100%),
			linear-gradient(0deg, #181b22 0%, rgba(24,27,34,0) 22%);
	}
	.hero .hero-split { width: 100%; grid-template-columns: minmax(0, 600px); }

	@media (min-width: 1025px) {
		.hero {
			min-height: calc(var(--nav-h, 108px) + min(42.7vw, 780px));
			padding-top: calc(var(--nav-h, 108px) + 30px);
			padding-bottom: 40px;
		}
	}
	@media (max-width: 1024px) {
		.hero-scene { width: 100%; -webkit-mask-image: none; mask-image: none; }
		.hero-shade {
			background:
				linear-gradient(90deg, rgba(14,15,20,0.9) 0%, rgba(14,15,20,0.55) 55%, rgba(14,15,20,0.25) 100%),
				linear-gradient(0deg, #181b22 0%, rgba(24,27,34,0) 30%);
		}
		.hero { min-height: min(86vh, 760px); }
	}
	@media (max-width: 768px) {
		.hero { display: block; min-height: 0; padding: var(--nav-h, 84px) 0 36px; }
		.hero-scene { position: relative; top: 0; width: 100%; height: auto; aspect-ratio: 3 / 2; display: block; }
		.hero-shade { top: var(--nav-h, 84px); bottom: auto; aspect-ratio: 3 / 2; background: linear-gradient(0deg, #181b22 0%, transparent 30%); }
		.hero .hero-split { padding-top: 8px; }
	}

	/* ── MEET THE CREW band ── */
	.crew-band {
		position: relative;
		background: #181b22;
		padding: 36px 0 64px;
	}
	.crew-band-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 22px;
	}
	.crew-band-eyebrow {
		font-family: 'Bebas Neue', sans-serif;
		font-size: 0.85rem;
		letter-spacing: 5px;
		color: #ff00ff;
		text-transform: uppercase;
		margin-bottom: 6px;
		opacity: 0.9;
	}
	.crew-band-title {
		font-family: 'Bebas Neue', sans-serif;
		font-size: clamp(2.2rem, 4vw, 3.2rem);
		letter-spacing: 3px;
		line-height: 1;
		color: #fff;
		text-shadow: 3px 3px 0 rgba(255,0,255,0.3), 0 0 40px rgba(255,0,255,0.15);
	}
	.crew-controls { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
	.carousel-arrow {
		background: rgba(255, 0, 255, 0.1);
		border: 1px solid rgba(255, 0, 255, 0.35);
		color: #ff00ff;
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.1rem;
		cursor: pointer;
		border-radius: 3px;
		transition: background 0.2s ease, box-shadow 0.2s ease;
	}
	.carousel-arrow:hover { background: rgba(255, 0, 255, 0.22); box-shadow: 0 0 12px rgba(255, 0, 255, 0.35); }
	.carousel-pause {
		margin-left: 6px;
		background: none;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 999px;
		color: rgba(255, 255, 255, 0.75);
		font: inherit;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 4px 12px;
		cursor: pointer;
	}
	.crew-viewport { overflow: hidden; }
	.crew-track {
		--per: 4;
		--gap: 20px;
		display: flex;
		gap: var(--gap);
		list-style: none;
		margin: 0;
		padding: 0;
		transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.crew-slide { flex: 0 0 calc((100% - (var(--per) - 1) * var(--gap)) / var(--per)); min-width: 0; }
	.crew-card {
		position: relative;
		display: block;
		aspect-ratio: 2 / 3;
		border-radius: 10px;
		overflow: hidden;
		border: 1px solid rgba(255, 0, 255, 0.18);
		background: #12141a;
		text-decoration: none;
		transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
	}
	.crew-card:hover, .crew-card:focus-visible {
		border-color: rgba(255, 0, 255, 0.6);
		box-shadow: 0 0 24px rgba(255, 0, 255, 0.25);
		transform: translateY(-3px);
	}
	.crew-card-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
	.crew-card-shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(14,15,20,0.85) 0%, rgba(14,15,20,0) 30%),
			linear-gradient(0deg, rgba(14,15,20,0.95) 0%, rgba(14,15,20,0.5) 26%, rgba(14,15,20,0) 48%);
	}
	.crew-card-quote {
		position: absolute;
		top: 14px;
		left: 14px;
		right: 14px;
		font-size: 0.8rem;
		font-style: italic;
		line-height: 1.5;
		color: #ff00ff;
		text-align: center;
		text-shadow: 0 0 12px rgba(255, 0, 255, 0.4), 0 1px 4px rgba(0, 0, 0, 0.9);
	}
	.crew-card-plate {
		position: absolute;
		left: 12px;
		right: 12px;
		bottom: 16px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
	}
	.crew-card-name {
		font-family: 'Bebas Neue', 'Impact', sans-serif;
		font-size: clamp(1.6rem, 2.2vw, 2.1rem);
		letter-spacing: 3px;
		line-height: 1;
		color: #fff;
		text-transform: uppercase;
		text-shadow: 0 0 20px rgba(255, 0, 255, 0.7), 2px 2px 0 rgba(0, 0, 0, 0.9);
	}
	.crew-card-role {
		padding: 3px 12px;
		background: rgba(255, 0, 255, 0.15);
		border: 1px solid rgba(255, 0, 255, 0.5);
		border-radius: 3px;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 3px;
		text-transform: uppercase;
		color: #ff00ff;
	}
	@media (max-width: 1099px) { .crew-track { --per: 3; } }
	@media (max-width: 767px) { .crew-track { --per: 2; --gap: 14px; } }
	@media (max-width: 768px) { .crew-band { padding-top: 8px; } }
	@media (max-width: 559px) {
		.crew-track { --per: 1; }
		.crew-slide { flex-basis: 86%; }
		.crew-band-head { flex-wrap: wrap; }
	}

</style>

<script>
	const form = document.getElementById('newsletterForm');
	const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
	const nlConfirm = document.getElementById('nl-confirm');

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const email = form.querySelector('input[type="email"]') as HTMLInputElement;
		if (!email?.value) return;

		const originalText = btn.textContent;
		btn.textContent = 'Subscribing...';
		btn.disabled = true;

		try {
			const res = await fetch('/api/subscribe', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: email.value })
			});
			const data = await res.json().catch(() => ({}));

			if (res.ok && data.ok) {
				form.style.display = 'none';
				if (nlConfirm) {
					if (data.already) {
						const signal = nlConfirm.querySelector('.nl-signal');
						if (signal) {
							signal.querySelector('.nl-signal__label')!.textContent = 'Already in the alley';
							signal.querySelector('.nl-signal__headline')!.textContent = 'We know you, stray.';
							signal.querySelector('.nl-signal__sub')!.textContent = "You signed up before. The crew's already got you covered.";
						}
					}
					nlConfirm.style.display = 'block';
				}
			} else {
				throw new Error('Subscription failed');
			}
		} catch (err) {
			btn.textContent = 'Something went wrong — try again';
			btn.disabled = false;
			setTimeout(() => { btn.textContent = originalText; }, 3000);
		}
	});
	// Listening now; the button was rendered disabled until this point.
	if (btn) btn.disabled = false;

	(function() {
		// "Meet the crew": a track of six cards showing 4 / 3 / 2 / 1 at a time.
		// Arrows and auto-advance step one card; it wraps from the end back to the start.
		const viewport = document.getElementById('heroCarousel');
		if (!viewport) return;
		const track = viewport.querySelector<HTMLElement>('.crew-track')!;
		const slides = Array.from(track.querySelectorAll<HTMLElement>('.crew-slide'));
		const prevBtn = document.getElementById('carouselPrev');
		const nextBtn = document.getElementById('carouselNext');
		const pauseBtn = document.getElementById('carouselPause');
		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;
		// Stopped by the Pause button, or from the start under reduced motion;
		// hover and focus pause it only while they last.
		let stopped = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let held = false;

		// Card positions relative to the first card (offsetLeft is measured from
		// the nearest positioned ancestor, not the track).
		const pos = (i: number) => slides[i].offsetLeft - slides[0].offsetLeft;
		function lastStart() {
			const vw = viewport!.clientWidth;
			const end = pos(slides.length - 1) + slides[slides.length - 1].offsetWidth;
			// the furthest first card that still fills the viewport
			for (let i = 0; i < slides.length; i++) {
				if (end - pos(i) <= vw + 2) return i;
			}
			return slides.length - 1;
		}
		function goTo(index: number) {
			const max = lastStart();
			current = index > max ? 0 : index < 0 ? max : index;
			track.style.transform = `translateX(${-pos(current)}px)`;
			slides.forEach((s, i) => {
				const visible = i >= current && pos(i) - pos(current) < viewport!.clientWidth - 2;
				s.toggleAttribute('inert', !visible);
				s.setAttribute('aria-hidden', String(!visible));
			});
		}
		function startTimer() {
			clearInterval(timer);
			if (stopped) return;
			timer = setInterval(() => { if (!held) goTo(current + 1); }, 4000);
		}
		function paintPause() {
			if (!pauseBtn) return;
			pauseBtn.textContent = stopped ? 'Play' : 'Pause';
			pauseBtn.setAttribute('aria-pressed', String(stopped));
			pauseBtn.setAttribute('aria-label', stopped ? 'Start the character slideshow' : 'Stop the character slideshow');
		}
		pauseBtn?.addEventListener('click', () => { stopped = !stopped; paintPause(); startTimer(); });
		viewport.addEventListener('mouseenter', () => { held = true; });
		viewport.addEventListener('mouseleave', () => { held = false; });
		viewport.addEventListener('focusin', () => { held = true; });
		viewport.addEventListener('focusout', () => { held = false; });
		prevBtn?.addEventListener('click', () => { goTo(current - 1); startTimer(); });
		nextBtn?.addEventListener('click', () => { goTo(current + 1); startTimer(); });

		// Touch: swipe left or right to step.
		let x0: number | null = null;
		viewport.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; held = true; }, { passive: true });
		viewport.addEventListener('touchend', (e) => {
			held = false;
			if (x0 === null) return;
			const dx = e.changedTouches[0].clientX - x0;
			x0 = null;
			if (Math.abs(dx) > 40) { goTo(current + (dx < 0 ? 1 : -1)); startTimer(); }
		});
		let rt: ReturnType<typeof setTimeout> | undefined;
		window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => goTo(Math.min(current, lastStart())), 150); });

		paintPause();
		goTo(0);
		startTimer();
	})();

	// ── The Alley drawer ─────────────────────────────────────
	// Only cards with a description render as buttons (and get a <dialog>); with
	// none, this finds nothing. The whole section is absent until a location
	// is featured on the homepage with an image.
	const ALLEY_HASH = '#the-alley/';
	const alleyDialogs = new Map<string, HTMLDialogElement>();
	document.querySelectorAll<HTMLDialogElement>('dialog[data-alley-drawer]').forEach((d) => {
		alleyDialogs.set(d.dataset.alleyDrawer!, d);
	});
	let alleyOpener: HTMLElement | null = null;
	let alleyOpenSlug: string | null = null;

	function alleyCardFor(slug: string) {
		return document.querySelector<HTMLElement>(`[data-alley-open="${CSS.escape(slug)}"]`);
	}

	function openAlley(slug: string, opener: HTMLElement | null) {
		const dialog = alleyDialogs.get(slug);
		if (!dialog || dialog.open) return;
		alleyDialogs.forEach((d, s) => { if (d.open) closeAlley(d, s); });
		alleyOpener = opener ?? alleyCardFor(slug);
		alleyOpenSlug = slug;
		dialog.showModal();
		dialog.querySelector<HTMLElement>('[data-alley-close]')?.focus();
		if (location.hash !== ALLEY_HASH + slug) {
			history.replaceState(null, '', ALLEY_HASH + slug);
		}
	}

	// Tidy up synchronously rather than waiting for the dialog's async 'close'
	// event (which a browser may defer, e.g. in a background tab); 'close' still
	// calls this as a fallback, so it must be safe to run twice.
	function closeAlley(dialog: HTMLDialogElement, slug: string) {
		if (dialog.open) dialog.close();
		if (alleyOpenSlug !== slug) return;
		alleyOpenSlug = null;
		if (location.hash === ALLEY_HASH + slug) {
			history.replaceState(null, '', location.pathname + location.search);
		}
		(alleyOpener ?? alleyCardFor(slug))?.focus();
		alleyOpener = null;
	}

	alleyDialogs.forEach((dialog, slug) => {
		dialog.addEventListener('close', () => closeAlley(dialog, slug));
		// Esc
		dialog.addEventListener('cancel', (e) => { e.preventDefault(); closeAlley(dialog, slug); });
		// A click on the dialog box itself (not the panel) is a backdrop click.
		dialog.addEventListener('click', (e) => { if (e.target === dialog) closeAlley(dialog, slug); });
		dialog.querySelector('[data-alley-close]')?.addEventListener('click', () => closeAlley(dialog, slug));
		dialog.addEventListener('keydown', (e) => {
			// Esc is handled here too, so closing never depends on the native 'cancel'.
			if (e.key === 'Escape') { e.preventDefault(); closeAlley(dialog, slug); return; }
			// Keep Tab inside the drawer.
			if (e.key !== 'Tab') return;
			const focusable = Array.from(dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
			if (!focusable.length) return;
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
			else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
		});
	});

	document.querySelectorAll<HTMLElement>('[data-alley-open]').forEach((card) => {
		card.addEventListener('click', () => openAlley(card.dataset.alleyOpen!, card));
	});

	function openAlleyFromHash() {
		if (!location.hash.startsWith(ALLEY_HASH)) return;
		const slug = decodeURIComponent(location.hash.slice(ALLEY_HASH.length));
		if (!alleyDialogs.has(slug)) return;
		alleyCardFor(slug)?.scrollIntoView({ block: 'center' });
		openAlley(slug, null);
	}
	window.addEventListener('hashchange', openAlleyFromHash);
	openAlleyFromHash();
</script>
