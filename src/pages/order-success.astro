---
/**
 * src/pages/order-success.astro  (Cats On Crack)
 *
 * Post-checkout landing page. Stripe redirects here after payment with
 * ?session_id=... — which triggers the cart clear. Voice matches the COC
 * transactional email ("Thanks for repping the alley").
 */
import Layout from '../layouts/Layout.astro';
---

<Layout title="Order Snagged — Cats On Crack" noIndex={true}>
  {/* Empty the cart once Stripe redirects back with a session_id.
      is:inline so it runs during parse, before the CartDrawer island hydrates. */}
  <script is:inline>
    if (new URLSearchParams(window.location.search).get('session_id')) {
      try { localStorage.removeItem('coc-cart-v1'); } catch (e) {}
    }
  </script>
  {/* The order reference: "#" + the last 8 characters of the session id,
      upper-cased, as in the confirmation email and the Sanity order. It is
      what /returns asks for. Shown once the page has loaded. */}
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var id = new URLSearchParams(window.location.search).get('session_id') || '';
      var box = document.getElementById('order-ref');
      var code = document.getElementById('order-ref-code');
      if (box && code && /^cs_[A-Za-z0-9_]{8,}$/.test(id)) {
        code.textContent = '#' + id.slice(-8).toUpperCase();
        box.hidden = false;
      }
    });
  </script>

  <section style={`
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
    text-align: center;
  `}>
    <div style="max-width: 520px;">
      <div style={`
        font-size: 64px;
        margin-bottom: 24px;
      `}>&#128062;</div>

      <h1 style={`
        font-size: 36px;
        font-weight: 700;
        color: #FF00FF;
        text-transform: uppercase;
        letter-spacing: 3px;
        margin: 0 0 16px;
      `}>Order Snagged</h1>

      <p id="order-ref" hidden style="margin: 0 0 16px; font-size: 15px; color: #ccc;">Order ref <strong id="order-ref-code" style="color: #FF00FF; letter-spacing: 1px; font-size: 18px;"></strong></p>

      <p style={`
        font-size: 16px;
        line-height: 1.7;
        color: #ccc;
        margin: 0 0 32px;
      `}>
        Thanks for repping the alley. A confirmation email is prowling its way
        to your inbox, and we'll send tracking the moment your gear claws out
        of production.
      </p>

      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/merch" style={`
          display: inline-block;
          padding: 12px 28px;
          background: #FF00FF;
          color: #000;
          text-decoration: none;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 1px;
          border-radius: 4px;
          font-size: 14px;
        `}>Keep Prowling</a>

        <a href="/" style={`
          display: inline-block;
          padding: 12px 28px;
          background: transparent;
          color: #ccc;
          text-decoration: none;
          font-weight: 600;
          border: 1px solid #333;
          border-radius: 4px;
          font-size: 14px;
        `}>Back to the Alley</a>
      </div>
    </div>
  </section>
</Layout>
